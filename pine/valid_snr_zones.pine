// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
//@version=6
indicator("Valid SnR Zones", shorttitle="Valid SnR", overlay=true, max_boxes_count=200, max_lines_count=200, max_labels_count=300, max_bars_back=500)

// Otomatisasi metode 6 langkah "SnR yang valid" untuk XAUUSD:
//   1. Zona diambil dari timeframe besar (H4 / H1): area tempat harga berkali-kali berbalik arah.
//   2. Yang digambar adalah ZONA (ujung wick sampai badan candle), bukan garis tipis.
//   3. Zona baru valid kalau sudah disentuh 2-3 kali dengan pantulan jelas; makin tajam reaksinya makin kuat.
//   4. Zona yang ditembus kuat berubah peran (flip): resistance jadi support, dan sebaliknya.
//   5. Entry hanya setelah ada konfirmasi di timeframe kecil: pin bar, engulfing, atau penolakan jelas.
//   6. Stop loss di luar zona dengan ruang untuk spike; angka bulat (.00 / .50) ikut ditampilkan.
// Zona dihitung ulang otomatis setiap candle timeframe besar selesai.

// ============================================================================
// INPUTS
// ============================================================================
string G1 = "1 - Zona dari timeframe besar"
zoneTFInput = input.timeframe("60", "Timeframe Zona (H4 atau H1)", group=G1, tooltip="Zona dicari di timeframe ini lalu ditampilkan di chart timeframe kecil. Kalau chart sama atau lebih besar dari nilai ini, timeframe chart yang dipakai.")
swingLeft   = input.int(3, "Swing: candle di kiri", minval=1, maxval=20, group=G1)
swingRight  = input.int(2, "Swing: candle di kanan", minval=1, maxval=20, group=G1, tooltip="Jumlah candle timeframe zona yang ditunggu untuk memastikan titik balik. Makin kecil makin cepat, makin besar makin ketat.")
minReact    = input.float(1.0, "Pantulan minimum (x ATR TF zona)", minval=0.1, step=0.1, group=G1, tooltip="Titik balik hanya dihitung sebagai sentuhan kalau harga memantul sejauh ini. Menyaring harga yang cuma lewat.")
minZoneH    = input.float(0.08, "Tinggi zona minimum (x ATR TF zona)", minval=0.02, step=0.01, group=G1)
maxZoneH    = input.float(0.3, "Tinggi zona maksimum (x ATR TF zona)", minval=0.05, step=0.05, group=G1, tooltip="Batas ketebalan zona. Turunkan kalau zona masih terlalu besar, naikkan kalau terlalu tipis.")
mergeTol    = input.float(0.15, "Toleransi gabung zona (x ATR TF zona)", minval=0.0, step=0.05, group=G1, tooltip="Titik balik yang jaraknya sedekat ini dari zona lama dianggap sentuhan pada zona yang sama.")

string G2 = "2 - Validasi dan umur zona"
minTouches     = input.int(2, "Sentuhan minimum agar valid", minval=2, maxval=5, group=G2)
showCandidates = input.bool(true, "Tampilkan kandidat (baru 1 sentuhan)", group=G2)
maxBreaks      = input.int(2, "Hapus zona setelah ditembus (kali)", minval=1, maxval=5, group=G2)
maxAgeBars     = input.int(400, "Hapus zona tanpa sentuhan baru setelah (candle TF zona)", minval=20, maxval=5000, group=G2)
zonesPerSide   = input.int(3, "Zona ditampilkan per sisi (terdekat)", minval=1, maxval=10, group=G2)
maxStored      = input.int(60, "Zona yang diingat", minval=10, maxval=200, group=G2)
extendBars     = input.int(30, "Perpanjang zona ke kanan (candle)", minval=1, maxval=200, group=G2)

string G3 = "3 - Konfirmasi entry (timeframe kecil)"
showEntries    = input.bool(true, "Tampilkan konfirmasi entry", group=G3)
usePin         = input.bool(true, "Pin bar", group=G3)
useEngulf      = input.bool(true, "Engulfing", group=G3)
useReject      = input.bool(true, "Penolakan jelas", group=G3)
pinRatio       = input.float(2.0, "Pin bar: wick minimal (x badan)", minval=1.0, step=0.1, group=G3)
signalCooldown = input.int(10, "Jeda antar sinyal di zona yang sama (candle)", minval=1, maxval=200, group=G3)
slAtrMult      = input.float(1.0, "Ruang SL di luar zona (x ATR chart)", minval=0.0, step=0.1, group=G3, tooltip="Jarak tambahan di luar zona supaya SL tidak tersapu spike.")
rr1            = input.float(1.0, "TP1 (x risiko)", minval=0.1, step=0.1, group=G3)
rr2            = input.float(2.0, "TP2 (x risiko)", minval=0.1, step=0.1, group=G3)

string G4 = "4 - Angka bulat"
showRound  = input.bool(true, "Tampilkan angka bulat", group=G4)
roundStep  = input.float(50.0, "Kelipatan angka bulat", minval=0.0001, group=G4, tooltip="50 untuk XAUUSD (harga berakhiran 00 dan 50). Sesuaikan untuk instrumen lain.")
roundCount = input.int(2, "Jumlah level per sisi", minval=1, maxval=5, group=G4)

string G5 = "5 - Tampilan"
supportColor = input.color(#22ab94, "Support", group=G5)
resistColor  = input.color(#f23645, "Resistance", group=G5)
goldColor    = input.color(#f5c542, "Aksen / angka bulat", group=G5)
entryColor   = input.color(#ffffff, "Garis entry", group=G5)
showPanel    = input.bool(true, "Tampilkan panel", group=G5)
panelPosOpt  = input.string("Top Right", "Posisi panel", options=["Top Left", "Top Right", "Bottom Left", "Bottom Right"], group=G5)

// ============================================================================
// HELPERS
// ============================================================================
getTablePosition(pos) =>
    switch pos
        "Top Left"     => position.top_left
        "Top Right"    => position.top_right
        "Bottom Left"  => position.bottom_left
        "Bottom Right" => position.bottom_right
        => position.top_right

tfName(string tf) =>
    switch tf
        "1"   => "M1"
        "3"   => "M3"
        "5"   => "M5"
        "15"  => "M15"
        "30"  => "M30"
        "60"  => "H1"
        "120" => "H2"
        "240" => "H4"
        "D"   => "D1"
        "1D"  => "D1"
        => tf

// ============================================================================
// DATA TIMEFRAME BESAR
// ============================================================================
atr = ta.atr(14)
int barMs = timeframe.in_seconds() * 1000

// Zona tidak bisa diambil dari timeframe yang lebih kecil dari chart
string zoneTF = timeframe.in_seconds(zoneTFInput) > timeframe.in_seconds() ? zoneTFInput : timeframe.period
int htfMs = timeframe.in_seconds(zoneTF) * 1000

// Semua nilai digeser satu candle ([1]) dan dibaca dengan lookahead, sehingga yang dipakai
// selalu candle timeframe besar yang SUDAH selesai. Zona tidak repaint.
htfData(int leftBars, int rightBars) =>
    float a  = ta.atr(14)
    float ph = ta.pivothigh(high, leftBars, rightBars)
    float pl = ta.pivotlow(low, leftBars, rightBars)
    float phBody = math.max(open[rightBars], close[rightBars])
    float plBody = math.min(open[rightBars], close[rightBars])
    float dropAfter = ph - ta.lowest(low, rightBars)
    float riseAfter = ta.highest(high, rightBars) - pl
    int   pivTime = time[rightBars]
    [ph[1], phBody[1], dropAfter[1], pl[1], plBody[1], riseAfter[1], a[1], pivTime[1], time[1], close[1]]

[hPh, hPhBody, hDrop, hPl, hPlBody, hRise, hAtr, hPivTime, hConfTime, hClose] = request.security(syminfo.tickerid, zoneTF, htfData(swingLeft, swingRight), lookahead=barmerge.lookahead_on)

// true pada candle chart pertama setelah satu candle timeframe besar selesai
bool newHtf = not na(hConfTime) and (na(hConfTime[1]) or hConfTime != hConfTime[1])

// ============================================================================
// ZONA
// ============================================================================
type Zone
    float top
    float bottom
    int   touches = 1
    float sumReact = 0.0
    int   role = 1
    int   breaks = 0
    bool  flipped = false
    int   leftTime = 0
    int   lastTime = 0
    bool  inside = false
    int   lastSignalBar = -100000

var array<Zone> zones = array.new<Zone>()

// Mencatat satu titik balik. Hasil: 1 = zona baru, 0 = sentuhan pada zona lama,
// 2 = sentuhan yang membuat zona lama menjadi valid.
addTouch(float zTop, float zBottom, float react, int pivTime, int nowTime, int roleHint, float tol, float maxH) =>
    int result = 1
    for z in zones
        if zTop + tol >= z.bottom and zBottom - tol <= z.top
            bool wasValid = z.touches >= minTouches
            z.touches += 1
            z.sumReact += react
            float nt = math.max(zTop, z.top)
            float nb = math.min(zBottom, z.bottom)
            if nt - nb <= maxH
                z.top := nt
                z.bottom := nb
            z.lastTime := nowTime
            result := not wasValid and z.touches >= minTouches ? 2 : 0
            break
    if result == 1
        int newRole = close > zTop ? 1 : close < zBottom ? -1 : roleHint
        zones.push(Zone.new(top=zTop, bottom=zBottom, touches=1, sumReact=react, role=newRole, leftTime=pivTime, lastTime=nowTime))
        if zones.size() > maxStored
            zones.shift()
    result

bool evNewValid = false
bool evFlip = false
bool evEnter = false

// --- Pembaruan otomatis setiap candle timeframe besar selesai ---
if newHtf and not na(hAtr)
    float tol  = hAtr * mergeTol
    float minH = hAtr * minZoneH
    float maxH = hAtr * maxZoneH

    // Langkah 4: zona yang ditembus oleh penutupan candle timeframe besar berubah peran (flip).
    // Zona yang terlalu sering ditembus atau terlalu lama tidak disentuh dihapus.
    int i = zones.size() - 1
    while i >= 0
        Zone z = zones.get(i)
        if z.role == -1 and hClose > z.top
            z.role := 1
            z.flipped := true
            z.breaks += 1
            if z.touches >= minTouches
                evFlip := true
        else if z.role == 1 and hClose < z.bottom
            z.role := -1
            z.flipped := true
            z.breaks += 1
            if z.touches >= minTouches
                evFlip := true
        if z.breaks > maxBreaks or hConfTime - z.lastTime > maxAgeBars * htfMs
            zones.remove(i)
        i -= 1

    // Langkah 1-3: titik balik baru. Zona = ujung wick sampai badan candle di area pantulan.
    if not na(hPh) and hDrop >= hAtr * minReact
        float rTop = hPh
        float rBottom = math.max(math.min(hPhBody, rTop - minH), rTop - maxH)
        if addTouch(rTop, rBottom, hDrop / hAtr, hPivTime, hConfTime, -1, tol, maxH) == 2
            evNewValid := true

    if not na(hPl) and hRise >= hAtr * minReact
        float sBottom = hPl
        float sTop = math.min(math.max(hPlBody, sBottom + minH), sBottom + maxH)
        if addTouch(sTop, sBottom, hRise / hAtr, hPivTime, hConfTime, 1, tol, maxH) == 2
            evNewValid := true

// ============================================================================
// LANGKAH 5: KONFIRMASI DI TIMEFRAME KECIL
// ============================================================================
float body   = math.abs(close - open)
float rng    = high - low
float lowerW = math.min(open, close) - low
float upperW = high - math.max(open, close)

bool pinBull = rng > 0 and lowerW >= pinRatio * body and lowerW >= 0.5 * rng and upperW <= 0.3 * rng
bool pinBear = rng > 0 and upperW >= pinRatio * body and upperW >= 0.5 * rng and lowerW <= 0.3 * rng
bool engBull = close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
bool engBear = close < open and close[1] > open[1] and close <= open[1] and open >= close[1]
bool strongBull = close > open and rng >= 0.8 * atr and close - low >= 0.6 * rng
bool strongBear = close < open and rng >= 0.8 * atr and high - close >= 0.6 * rng

int    sigDir = 0
string sigPattern = ""
float  sigEdge = na

if barstate.isconfirmed and not na(atr)
    for z in zones
        bool valid = z.touches >= minTouches
        bool touching = high >= z.bottom and low <= z.top
        if touching and not z.inside and valid
            evEnter := true
        z.inside := touching

        if showEntries and sigDir == 0 and valid and bar_index - z.lastSignalBar > signalCooldown
            if z.role == 1 and low <= z.top and close > z.bottom and open >= z.bottom - atr * 0.25
                string p = ""
                if usePin and pinBull
                    p := "PIN BAR"
                else if useEngulf and engBull
                    p := "ENGULFING"
                else if useReject and strongBull and close > z.top
                    p := "PENOLAKAN"
                if p != ""
                    sigDir := 1
                    sigPattern := p
                    sigEdge := z.bottom
                    z.lastSignalBar := bar_index
            else if z.role == -1 and high >= z.bottom and close < z.top and open <= z.top + atr * 0.25
                string q = ""
                if usePin and pinBear
                    q := "PIN BAR"
                else if useEngulf and engBear
                    q := "ENGULFING"
                else if useReject and strongBear and close < z.bottom
                    q := "PENOLAKAN"
                if q != ""
                    sigDir := -1
                    sigPattern := q
                    sigEdge := z.top
                    z.lastSignalBar := bar_index

bool evBuy  = sigDir == 1
bool evSell = sigDir == -1

// ============================================================================
// LANGKAH 6: ENTRY, STOP LOSS DI LUAR ZONA, TARGET
// ============================================================================
var array<line>  trLines  = array.new<line>()
var array<label> trLabels = array.new<label>()
var bool   trActive = false
var int    trDir = 0
var int    trStartBar = na
var float  trSL = na
var float  trTP = na
var string lastSignalText = "-"

if sigDir != 0
    for l in trLines
        line.delete(l)
    trLines.clear()
    for lb in trLabels
        label.delete(lb)
    trLabels.clear()

    float entry = close
    // SL di luar zona dan di luar ekor candle konfirmasi, ditambah ruang untuk spike
    float sl = sigDir == 1 ? math.min(sigEdge, low) - atr * slAtrMult : math.max(sigEdge, high) + atr * slAtrMult
    float risk = math.abs(entry - sl)
    float tp1 = entry + sigDir * risk * rr1
    float tp2 = entry + sigDir * risk * rr2
    int xr = bar_index + 12

    label.new(bar_index, sigDir == 1 ? low : high, (sigDir == 1 ? "BUY" : "SELL") + "\n" + sigPattern, style=sigDir == 1 ? label.style_label_up : label.style_label_down, color=sigDir == 1 ? supportColor : resistColor, textcolor=color.white, size=size.small)

    trLines.push(line.new(bar_index, entry, xr, entry, color=entryColor, width=2))
    trLines.push(line.new(bar_index, sl, xr, sl, color=resistColor, style=line.style_dashed, width=2))
    trLines.push(line.new(bar_index, tp1, xr, tp1, color=supportColor, width=1))
    trLines.push(line.new(bar_index, tp2, xr, tp2, color=supportColor, width=2))
    trLabels.push(label.new(xr, entry, "ENTRY " + str.tostring(entry, format.mintick), style=label.style_label_left, color=entryColor, textcolor=color.black, size=size.small))
    trLabels.push(label.new(xr, sl, "STOP LOSS " + str.tostring(sl, format.mintick), style=label.style_label_left, color=resistColor, textcolor=color.white, size=size.small))
    trLabels.push(label.new(xr, tp1, "TP1 " + str.tostring(tp1, format.mintick), style=label.style_label_left, color=supportColor, textcolor=color.white, size=size.small))
    trLabels.push(label.new(xr, tp2, "TP2 " + str.tostring(tp2, format.mintick), style=label.style_label_left, color=supportColor, textcolor=color.white, size=size.small))

    trActive := true
    trDir := sigDir
    trStartBar := bar_index
    trSL := sl
    trTP := tp2
    lastSignalText := (sigDir == 1 ? "BUY - " : "SELL - ") + sigPattern

// Garis mengikuti harga sampai SL atau TP2 tersentuh, lalu berhenti
if trActive
    if bar_index > trStartBar
        bool slHit = trDir == 1 ? low <= trSL : high >= trSL
        bool tpHit = trDir == 1 ? high >= trTP : low <= trTP
        if slHit or tpHit
            trActive := false
    if trActive
        for l in trLines
            line.set_x2(l, bar_index + 12)
        for lb in trLabels
            label.set_x(lb, bar_index + 12)

// ============================================================================
// GAMBAR ZONA, ANGKA BULAT DAN PANEL (diperbarui di candle terakhir)
// ============================================================================
var array<box>   zoneBoxes   = array.new<box>()
var array<line>  roundLines  = array.new<line>()
var array<label> roundLabels = array.new<label>()

zoneRangeText(Zone z) =>
    str.tostring(z.bottom, format.mintick) + " - " + str.tostring(z.top, format.mintick) + "  (" + str.tostring(z.touches) + "x)"

drawZone(Zone z) =>
    bool valid = z.touches >= minTouches
    color c = z.role == 1 ? supportColor : resistColor
    float avgReact = z.sumReact / z.touches
    string stars = avgReact >= 3 ? "★★★" : avgReact >= 2 ? "★★" : "★"
    bool hasRound = showRound and math.floor(z.top / roundStep) * roundStep >= z.bottom
    string txt = z.role == 1 ? "SUPPORT" : "RESISTANCE"
    if valid
        txt += "  " + str.tostring(z.touches) + "x " + stars
    else
        txt += "  kandidat " + str.tostring(z.touches) + "x"
    if z.flipped
        txt += "  FLIP"
    if hasRound
        txt += "  +angka bulat"
    box b = box.new(z.leftTime, z.top, time + extendBars * barMs, z.bottom, xloc=xloc.bar_time, bgcolor=color.new(c, valid ? 78 : 93), border_color=color.new(c, valid ? 15 : 60), border_style=valid ? line.style_solid : line.style_dashed, border_width=1, text=txt, text_color=color.new(c, valid ? 0 : 35), text_size=size.small, text_halign=text.align_right, text_valign=text.align_center)
    zoneBoxes.push(b)

Zone nearRes = na
Zone nearSup = na
Zone insideZone = na

if barstate.islast
    for b in zoneBoxes
        box.delete(b)
    zoneBoxes.clear()

    array<float> keysUp = array.new<float>()
    array<int>   idxUp  = array.new<int>()
    array<float> keysDn = array.new<float>()
    array<int>   idxDn  = array.new<int>()

    for [k, z] in zones
        bool valid = z.touches >= minTouches
        if z.bottom > close
            if valid
                if na(nearRes)
                    nearRes := z
                else if z.bottom < nearRes.bottom
                    nearRes := z
            if valid or showCandidates
                keysUp.push(z.bottom)
                idxUp.push(k)
        else if z.top < close
            if valid
                if na(nearSup)
                    nearSup := z
                else if z.top > nearSup.top
                    nearSup := z
            if valid or showCandidates
                keysDn.push(-z.top)
                idxDn.push(k)
        else
            // harga sedang di dalam zona: selalu digambar
            if valid
                insideZone := z
            if valid or showCandidates
                drawZone(z)

    if keysUp.size() > 0
        array<int> ordUp = array.sort_indices(keysUp, order.ascending)
        int shownValidUp = 0
        int shownCandUp = 0
        for j in ordUp
            Zone zz = zones.get(idxUp.get(j))
            if zz.touches >= minTouches
                if shownValidUp < zonesPerSide
                    drawZone(zz)
                    shownValidUp += 1
            else if shownCandUp < 2
                drawZone(zz)
                shownCandUp += 1

    if keysDn.size() > 0
        array<int> ordDn = array.sort_indices(keysDn, order.ascending)
        int shownValidDn = 0
        int shownCandDn = 0
        for j in ordDn
            Zone zz = zones.get(idxDn.get(j))
            if zz.touches >= minTouches
                if shownValidDn < zonesPerSide
                    drawZone(zz)
                    shownValidDn += 1
            else if shownCandDn < 2
                drawZone(zz)
                shownCandDn += 1

    // Angka bulat (level psikologis)
    for l in roundLines
        line.delete(l)
    roundLines.clear()
    for lb in roundLabels
        label.delete(lb)
    roundLabels.clear()
    if showRound
        float baseLevel = math.floor(close / roundStep) * roundStep
        for n = 1 - roundCount to roundCount
            float lv = baseLevel + n * roundStep
            roundLines.push(line.new(time - 300 * barMs, lv, time + extendBars * barMs, lv, xloc=xloc.bar_time, color=color.new(goldColor, 40), style=line.style_dashed, width=1))
            roundLabels.push(label.new(time + extendBars * barMs, lv, str.tostring(lv, "#.00"), xloc=xloc.bar_time, style=label.style_label_left, color=color.new(goldColor, 100), textcolor=goldColor, size=size.small))

panelRow(table t, int row, string name, string value, color valueColor) =>
    table.cell(t, 0, row, name, text_color=#9aa4b5, bgcolor=#0b1220, text_size=size.small, text_halign=text.align_left)
    table.cell(t, 1, row, value, text_color=valueColor, bgcolor=#0b1220, text_size=size.small, text_halign=text.align_right)

if showPanel and barstate.islast
    var table panel = table.new(getTablePosition(panelPosOpt), 2, 7, bgcolor=#0b1220, border_width=1, border_color=#1f2a3d, frame_width=1, frame_color=goldColor)
    table.cell(panel, 0, 0, "VALID SnR ZONES", text_color=goldColor, bgcolor=#111a2c, text_size=size.small, text_halign=text.align_center)
    table.merge_cells(panel, 0, 0, 1, 0)

    panelRow(panel, 1, "TF zona", tfName(zoneTF), color.white)

    string resText = "belum ada"
    string supText = "belum ada"
    if not na(nearRes)
        resText := zoneRangeText(nearRes)
    if not na(nearSup)
        supText := zoneRangeText(nearSup)
    panelRow(panel, 2, "Resistance terdekat", resText, resistColor)
    panelRow(panel, 3, "Support terdekat", supText, supportColor)

    string statusText = "Di antara zona - tunggu harga ke zona"
    color  statusColor = color.white
    if not na(insideZone)
        statusText := insideZone.role == 1 ? "Di SUPPORT - tunggu konfirmasi" : "Di RESISTANCE - tunggu konfirmasi"
        statusColor := insideZone.role == 1 ? supportColor : resistColor
    panelRow(panel, 4, "Status", statusText, statusColor)

    float roundBelow = math.floor(close / roundStep) * roundStep
    panelRow(panel, 5, "Angka bulat", str.tostring(roundBelow, "#.00") + " / " + str.tostring(roundBelow + roundStep, "#.00"), goldColor)
    panelRow(panel, 6, "Sinyal terakhir", lastSignalText, color.white)

// ============================================================================
// ALERTS
// ============================================================================
alertcondition(evBuy, title="Konfirmasi BUY di support", message="Valid SnR: konfirmasi BUY di zona support")
alertcondition(evSell, title="Konfirmasi SELL di resistance", message="Valid SnR: konfirmasi SELL di zona resistance")
alertcondition(evEnter, title="Harga masuk zona valid", message="Valid SnR: harga masuk zona valid, tunggu konfirmasi")
alertcondition(evNewValid, title="Zona baru menjadi valid", message="Valid SnR: ada zona baru yang valid")
alertcondition(evFlip, title="Flip zone", message="Valid SnR: zona ditembus dan berubah peran (flip)")
alertcondition(evBuy or evSell or evEnter or evNewValid or evFlip, title="Semua kejadian", message="Valid SnR: ada kejadian di zona")
