//@version=6
indicator("PIPS HUNTER", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=500)

// === INPUTS ===
showRibbon = input.bool(true, "Show EMA Ribbon", group="EMA Settings")
emaFastLen = input.int(11, "EMA Fast Length", minval=1, group="EMA Settings")
emaSlowLen = input.int(34, "EMA Slow Length", minval=2, group="EMA Settings")

// Signal filters
confirmOnClose = input.bool(true, "Signal Only On Bar Close (no repaint)", group="Signal Filters")
signalWindow   = input.int(8, "Bars To Wait For Filters After Cross", minval=0, maxval=20, group="Signal Filters", tooltip="After an EMA cross, the signal may still fire within this many bars as soon as every enabled filter agrees. 0 = only on the cross bar.")
useTrendFilter = input.bool(true, "Trend Filter (price vs Trend EMA)", group="Signal Filters")
trendEmaLen    = input.int(200, "Trend EMA Length", minval=1, group="Signal Filters")
useAdxFilter   = input.bool(true, "ADX Filter (skip sideways market)", group="Signal Filters")
adxLen         = input.int(14, "ADX Length", minval=1, group="Signal Filters")
adxThreshold   = input.float(20.0, "ADX Minimum", minval=0, step=0.5, group="Signal Filters")
adxAllowRising = input.bool(true, "Also Accept Rising ADX", group="Signal Filters", tooltip="ADX reacts late right after a reversal. With this on, a signal is also accepted while ADX is still below the minimum but rising for 2 bars with DI pointing in the signal direction.")
useHtfFilter   = input.bool(false, "Higher Timeframe Filter", group="Signal Filters")
htfTimeframe   = input.timeframe("60", "Higher Timeframe", group="Signal Filters")
useZoneFilter  = input.bool(true, "Supply/Demand Filter", group="Signal Filters", tooltip="Blocks Buy signals while price is inside a supply zone and Sell signals while price is inside a demand zone.")

// Trend continuation (re-entry) signals
useContinuation  = input.bool(true, "Trend Continuation Signals", group="Continuation Signals", tooltip="During a trend with no new EMA cross, gives a new signal each time price pulls back to the fast EMA and then resumes in the trend direction.")
pullbackLookback = input.int(5, "Pullback Lookback (bars)", minval=1, maxval=30, group="Continuation Signals")
cooldownBars     = input.int(5, "Minimum Bars Between Signals", minval=1, maxval=100, group="Continuation Signals")

// Trade management
tpCount = input.int(4, "Number of Take Profits", minval=1, maxval=4, group="Trade Management")
atrrMultiplier = input.float(2, "ATR Multiplier for SL", minval=0.1, step=0.1, group="Trade Management")
atrrTPFactor = input.float(1.0, "TP Multiplier (relative to SL)", minval=0.1, step=0.1, group="Trade Management")
atrLen = input.int(14, "ATR Length", minval=1, group="Trade Management")
showTP_SL_Lines = input.bool(true, "Show TP/SL Lines & Boxes", group="Trade Management")

// Supply & Demand
showZones     = input.bool(true, "Enable Supply & Demand Zones", group="Supply & Demand")
swingLen      = input.int(10, "Swing Length", minval=2, maxval=50, group="Supply & Demand", tooltip="Bars on each side of a swing high/low. A zone appears this many bars after the swing, once it is confirmed.")
impulseMult   = input.float(1.5, "Minimum Move Away From Zone (x ATR)", minval=0, step=0.1, group="Supply & Demand", tooltip="Price must leave the swing by at least this much before a zone is drawn. Higher = fewer, stronger zones.")
zoneMinWidth  = input.float(0.25, "Minimum Zone Height (x ATR)", minval=0.05, step=0.05, group="Supply & Demand")
zoneMaxWidth  = input.float(1.5, "Maximum Zone Height (x ATR)", minval=0.1, step=0.1, group="Supply & Demand")
maxZones      = input.int(5, "Max Zones Per Side", minval=1, maxval=20, group="Supply & Demand")
breakMode     = input.string("Close", "Zone Broken By", options=["Close", "Wick"], group="Supply & Demand")
showBroken    = input.bool(false, "Keep Broken Zones (grey)", group="Supply & Demand")
zoneExtend    = input.int(20, "Extend Zones Right (bars)", minval=1, maxval=200, group="Supply & Demand")
supplyColor   = input.color(#f23645, "Supply Color", group="Supply & Demand")
demandColor   = input.color(#089981, "Demand Color", group="Supply & Demand")

// Dashboard Input
showDashboard = input.bool(true, "Show Trend Analysis Dashboard", group="Dashboard Settings")
dashboardPosition = input.string("Bottom Right", "Dashboard Position", options=["Top Left", "Top Right", "Bottom Left", "Bottom Right"], group="Dashboard Settings")
combinedTrendTF1 = input.string("5", "Combined Trend Timeframe 1", options=["5", "15", "30", "60", "240", "D"], group="Dashboard Settings")
combinedTrendTF2 = input.string("15", "Combined Trend Timeframe 2", options=["5", "15", "30", "60", "240", "D"], group="Dashboard Settings")
combinedTrendTF3 = input.string("30", "Combined Trend Timeframe 3", options=["5", "15", "30", "60", "240", "D"], group="Dashboard Settings")
showMarket = input.bool(true, "Show Market Analysis Dashboard", group="Dashboard Settings")

// Unified Border Color Input
widgetBorderColor = input.color(#000000, "Screener & Dashboard border's colors", group="Widget Style", tooltip="Changes all borders and outlines for both screener and dashboard")

// === SCREENER INPUTS ===
showScreener = input.bool(true, "Show Screener", group="Screener Settings")
screenerPosition = input.string("Top Right", "Screener Position", options=["Top Left", "Top Right", "Bottom Left", "Bottom Right"], group="Screener Settings")

// === HELPER FUNCTIONS ===
getTablePosition(pos) =>
    switch pos
        "Top Left"     => position.top_left
        "Top Right"    => position.top_right
        "Bottom Left"  => position.bottom_left
        "Bottom Right" => position.bottom_right
        => position.top_right

// === CALCULATIONS ===
emaFast  = ta.ema(close, emaFastLen)
emaSlow  = ta.ema(close, emaSlowLen)
emaTrend = ta.ema(close, trendEmaLen)
atr      = ta.atr(atrLen)
[diPlus, diMinus, adx] = ta.dmi(adxLen, adxLen)

// Ribbon direction
ribbonDir = emaSlow < emaFast

// Raw crossovers (before filters)
rawLong  = ta.crossover(emaFast, emaSlow)
rawShort = ta.crossunder(emaFast, emaSlow)

// Higher timeframe trend, taken from the last CLOSED higher-timeframe bar so it never repaints
[htfFast, htfSlow] = request.security(syminfo.tickerid, htfTimeframe, [emaFast[1], emaSlow[1]], lookahead=barmerge.lookahead_on)

// === SUPPLY & DEMAND ZONES ===
type Zone
    box   bx
    float top
    float bottom
    int   tests = 0
    bool  inside = false

var array<Zone> supplyZones = array.new<Zone>()
var array<Zone> demandZones = array.new<Zone>()

zoneText(bool isSupply, int tests) =>
    (isSupply ? "SUPPLY" : "DEMAND") + (tests > 0 ? " • test " + str.tostring(tests) : "")

zoneOverlaps(array<Zone> zones, float top, float bottom) =>
    bool res = false
    for z in zones
        if top >= z.bottom and bottom <= z.top
            res := true
            break
    res

addZone(array<Zone> zones, float top, float bottom, int leftBar, bool isSupply) =>
    if not zoneOverlaps(zones, top, bottom)
        color c = isSupply ? supplyColor : demandColor
        box b = box.new(leftBar, top, bar_index + zoneExtend, bottom, border_color=color.new(c, 40), border_width=1, bgcolor=color.new(c, 82), text=zoneText(isSupply, 0), text_color=color.new(c, 0), text_size=size.small, text_halign=text.align_right, text_valign=text.align_center)
        zones.push(Zone.new(b, top, bottom))
        if zones.size() > maxZones
            Zone old = zones.shift()
            box.delete(old.bx)

// Extends live zones, counts retests, retires broken zones.
// Returns [price is inside a zone, a zone was freshly tested on this bar]
updateZones(array<Zone> zones, bool isSupply) =>
    bool priceInside = false
    bool newTest = false
    int i = zones.size() - 1
    while i >= 0
        Zone z = zones.get(i)
        bool broken = false
        if isSupply
            broken := breakMode == "Close" ? close > z.top : high > z.top
        else
            broken := breakMode == "Close" ? close < z.bottom : low < z.bottom
        if broken
            if showBroken
                box.set_right(z.bx, bar_index)
                box.set_bgcolor(z.bx, color.new(color.gray, 90))
                box.set_border_color(z.bx, color.new(color.gray, 70))
                box.set_text(z.bx, "")
            else
                box.delete(z.bx)
            zones.remove(i)
        else
            box.set_right(z.bx, bar_index + zoneExtend)
            bool touching = isSupply ? high >= z.bottom : low <= z.top
            if touching and not z.inside
                z.tests += 1
                newTest := true
                box.set_text(z.bx, zoneText(isSupply, z.tests))
            z.inside := touching
            if close <= z.top and close >= z.bottom
                priceInside := true
        i -= 1
    [priceInside, newTest]

// Nearest zone edge to current price (na when there is none)
nearestSupply(array<Zone> zones) =>
    float res = na
    for z in zones
        if z.top >= close and (na(res) or z.bottom < res)
            res := z.bottom
    res

nearestDemand(array<Zone> zones) =>
    float res = na
    for z in zones
        if z.bottom <= close and (na(res) or z.top > res)
            res := z.top
    res

// Swing detection (confirmed swingLen bars later, so zones never repaint)
pivotHigh = ta.pivothigh(high, swingLen, swingLen)
pivotLow  = ta.pivotlow(low, swingLen, swingLen)
lowestSince  = ta.lowest(low, swingLen)
highestSince = ta.highest(high, swingLen)

bool inSupply = false
bool inDemand = false
bool supplyTested = false
bool demandTested = false

if showZones
    [_inS, _testS] = updateZones(supplyZones, true)
    [_inD, _testD] = updateZones(demandZones, false)
    inSupply := _inS
    inDemand := _inD
    supplyTested := _testS
    demandTested := _testD

    // New supply zone: swing high followed by a strong move down
    if not na(pivotHigh) and not na(atr)
        float sTop = pivotHigh
        float sBody = math.max(open[swingLen], close[swingLen])
        float sBottom = math.max(math.min(sBody, sTop - atr * zoneMinWidth), sTop - atr * zoneMaxWidth)
        if sTop - lowestSince >= atr * impulseMult and close < sBottom
            addZone(supplyZones, sTop, sBottom, bar_index - swingLen, true)

    // New demand zone: swing low followed by a strong move up
    if not na(pivotLow) and not na(atr)
        float dBottom = pivotLow
        float dBody = math.min(open[swingLen], close[swingLen])
        float dTop = math.min(math.max(dBody, dBottom + atr * zoneMinWidth), dBottom + atr * zoneMaxWidth)
        if highestSince - dBottom >= atr * impulseMult and close > dTop
            addZone(demandZones, dTop, dBottom, bar_index - swingLen, false)

// === TRADE STATE VARIABLES ===
var array<float> currentTPLevels = array.new<float>()
var array<bool> tpHitStatus = array.new<bool>()
var float currentSLLevel = na
var int tradeDirection = 0
var bool tradeActive = false
var int tradeStartBar = na
var int tradeEndX = na
var array<line> tpLines = array.new<line>()
var line slLine = na
var line entryLine = na
var array<label> rightLabels = array.new<label>()
var box tpBox = na
var box slBox = na
var int tp1Wins = 0
var int slLosses = 0

// === SIGNAL GENERATION ===
trendLongOK  = not useTrendFilter or close > emaTrend
trendShortOK = not useTrendFilter or close < emaTrend
adxRising    = adx > adx[1] and adx[1] > adx[2]
adxLongOK    = not useAdxFilter or adx >= adxThreshold or (adxAllowRising and adxRising and diPlus > diMinus)
adxShortOK   = not useAdxFilter or adx >= adxThreshold or (adxAllowRising and adxRising and diMinus > diPlus)
htfLongOK    = not useHtfFilter or htfFast > htfSlow
htfShortOK   = not useHtfFilter or htfFast < htfSlow
zoneLongOK   = not (useZoneFilter and showZones) or not inSupply
zoneShortOK  = not (useZoneFilter and showZones) or not inDemand

longFiltersOK  = trendLongOK and adxLongOK and htfLongOK and zoneLongOK
shortFiltersOK = trendShortOK and adxShortOK and htfShortOK and zoneShortOK

// A cross stays "pending" for a few bars so a good setup is not lost
// just because one filter lagged by a candle.
var int pendingDir = 0
var int pendingBar = na
if rawLong
    pendingDir := 1
    pendingBar := bar_index
if rawShort
    pendingDir := -1
    pendingBar := bar_index

barOK = not confirmOnClose or barstate.isconfirmed
pendingValid = pendingDir != 0 and bar_index - pendingBar <= signalWindow
crossLong  = barOK and pendingValid and pendingDir == 1 and ribbonDir and longFiltersOK
crossShort = barOK and pendingValid and pendingDir == -1 and not ribbonDir and shortFiltersOK

// Trend continuation: price pulled back to the fast EMA, then resumed with the trend.
var int lastSignalBar = na
touchedFromAbove = ta.lowest(low - emaFast, pullbackLookback) <= 0
touchedFromBelow = ta.highest(high - emaFast, pullbackLookback) >= 0
tp1Done = array.size(tpHitStatus) > 0 and array.get(tpHitStatus, 0)
cooledDown = na(lastSignalBar) or bar_index - lastSignalBar >= cooldownBars
// A same-direction re-entry is only allowed once the running trade is finished or already reached TP1.
canLong  = not tradeActive or tradeDirection != 1 or tp1Done
canShort = not tradeActive or tradeDirection != -1 or tp1Done
contLong  = useContinuation and barOK and cooledDown and canLong and ribbonDir and emaFast > emaFast[1] and touchedFromAbove and close > emaFast and close > high[1] and longFiltersOK
contShort = useContinuation and barOK and cooledDown and canShort and not ribbonDir and emaFast < emaFast[1] and touchedFromBelow and close < emaFast and close < low[1] and shortFiltersOK

longSignal  = crossLong or (contLong and not crossShort)
shortSignal = not longSignal and (crossShort or contShort)
if longSignal or shortSignal
    pendingDir := 0
    lastSignalBar := bar_index

// An EMA cross that ran out of time is dropped.
if pendingDir != 0 and bar_index - pendingBar > signalWindow
    pendingDir := 0

// === PLOTS ===
pFast = plot(emaFast, color=showRibbon ? (ribbonDir ? color.rgb(78, 247, 0) : color.rgb(250, 0, 0)) : na, linewidth=2, style=plot.style_circles, title="EMA Fast")
pSlow = plot(emaSlow, color=showRibbon ? color.new(ribbonDir ? color.rgb(78, 247, 0) : color.rgb(250, 0, 0), 50) : na, linewidth=1, title="EMA Slow")
fill(pFast, pSlow, color=showRibbon ? color.new(ribbonDir ? color.rgb(78, 247, 0) : color.rgb(250, 0, 0), 88) : na, title="Ribbon Fill")
plot(useTrendFilter ? emaTrend : na, color=color.new(color.orange, 20), linewidth=2, title="Trend EMA")

// === SIGNAL HANDLING ===
if longSignal or shortSignal
    // Delete previous drawings
    for ln in tpLines
        line.delete(ln)
    array.clear(tpLines)

    if not na(slLine)
        line.delete(slLine)
        slLine := na

    if not na(entryLine)
        line.delete(entryLine)
        entryLine := na

    for lb in rightLabels
        label.delete(lb)
    array.clear(rightLabels)

    if not na(tpBox)
        box.delete(tpBox)
    tpBox := na

    if not na(slBox)
        box.delete(slBox)
    slBox := na

    // Setup new trade state
    tradeActive := true
    tradeStartBar := bar_index
    tradeEndX := na
    tradeDirection := longSignal ? 1 : -1
    entry = close
    currentSLLevel := entry - tradeDirection * atr * atrrMultiplier

    // Calculate and store TP Levels
    array.clear(currentTPLevels)
    array.clear(tpHitStatus)
    for i = 1 to tpCount
        tp = entry + tradeDirection * atr * atrrMultiplier * atrrTPFactor * i
        array.push(currentTPLevels, tp)
        array.push(tpHitStatus, false)
    float lastTP = array.get(currentTPLevels, array.size(currentTPLevels) - 1)

    // Create Horizontal TP/SL/Entry Lines, Right-Side Labels & background boxes
    int xRightInitial = bar_index + 10

    if showTP_SL_Lines
        entryRightLabel = label.new(xRightInitial, entry, "ENTRY : " + str.tostring(entry, format.mintick), style=label.style_label_left, color=#fff100, textcolor=color.black, size=size.normal)
        array.push(rightLabels, entryRightLabel)
        entryLine := line.new(bar_index, entry, xRightInitial, entry, color=#fff100, style=line.style_solid, width=2)

        for i = 0 to array.size(currentTPLevels) - 1
            yVal = array.get(currentTPLevels, i)
            tpLine = line.new(bar_index, yVal, xRightInitial, yVal, color=#00ff00, style=line.style_solid, width=2)
            array.push(tpLines, tpLine)

            tpLabelText = "TP " + str.tostring(i + 1) + " : " + str.tostring(yVal, format.mintick)
            tpRightLabel = label.new(xRightInitial, yVal, tpLabelText, style=label.style_label_left, color=#00ff00, textcolor=color.black, size=size.normal)
            array.push(rightLabels, tpRightLabel)
//join telegram @traderschatroom88
        slLine := line.new(bar_index, currentSLLevel, xRightInitial, currentSLLevel, color=color.red, style=line.style_solid, width=2)
        slRightLabel = label.new(xRightInitial, currentSLLevel, "SL : " + str.tostring(currentSLLevel, format.mintick), style=label.style_label_left, color=color.red, textcolor=color.white, size=size.normal)
        array.push(rightLabels, slRightLabel)

        tpBox := box.new(bar_index, math.max(entry, lastTP), xRightInitial, math.min(entry, lastTP), bgcolor=color.new(#089981, 80), border_color=color.rgb(0, 0, 0, 100))
        slBox := box.new(bar_index, math.max(entry, currentSLLevel), xRightInitial, math.min(entry, currentSLLevel), bgcolor=color.new(#f23645, 80), border_color=color.rgb(0, 0, 0, 100))

// === TRADE MANAGEMENT ===
// Outcome tracking starts on the bar AFTER entry (entry is the signal bar's close).
if tradeActive and bar_index > tradeStartBar
    slHit = (tradeDirection > 0 and low <= currentSLLevel) or (tradeDirection < 0 and high >= currentSLLevel)

    if slHit
        // If SL and a TP are touched on the same bar we assume the worst case (SL first).
        if not array.get(tpHitStatus, 0)
            slLosses += 1
        tradeActive := false
        tradeEndX := bar_index
    else
        bool allTPsHit = true
        for i = 0 to array.size(currentTPLevels) - 1
            tpLevel = array.get(currentTPLevels, i)
            isTPHitThisBar = (tradeDirection > 0 and high >= tpLevel) or (tradeDirection < 0 and low <= tpLevel)
            if isTPHitThisBar and not array.get(tpHitStatus, i)
                array.set(tpHitStatus, i, true)
                if i == 0
                    tp1Wins += 1
            if not array.get(tpHitStatus, i)
                allTPsHit := false
        if allTPsHit
            tradeActive := false
            tradeEndX := bar_index

// Keep drawings extended while the trade is live, freeze them once it ends
if showTP_SL_Lines and (tradeActive or not na(tradeEndX))
    int xRight = (tradeActive ? bar_index : tradeEndX) + 10

    if not na(entryLine)
        line.set_x2(entryLine, xRight)
    for ln in tpLines
        line.set_x2(ln, xRight)
    if not na(slLine)
        line.set_x2(slLine, xRight)
    for lb in rightLabels
        label.set_x(lb, xRight)
    if not na(tpBox)
        box.set_right(tpBox, xRight)
    if not na(slBox)
        box.set_right(slBox, xRight)

// === ALERTS ===
alertcondition(longSignal, title="Long Signal", message="PIPS HUNTER: Buy signal")
alertcondition(shortSignal, title="Short Signal", message="PIPS HUNTER: Sell signal")
alertcondition(supplyTested, title="Supply Zone Tested", message="Price entered a supply zone")
alertcondition(demandTested, title="Demand Zone Tested", message="Price entered a demand zone")

// === MULTI-TIMEFRAME TREND DATA ===
[tf5_fast, tf5_slow]     = request.security(syminfo.tickerid, "5", [emaFast, emaSlow], lookahead=barmerge.lookahead_off)
[tf15_fast, tf15_slow]   = request.security(syminfo.tickerid, "15", [emaFast, emaSlow], lookahead=barmerge.lookahead_off)
[tf30_fast, tf30_slow]   = request.security(syminfo.tickerid, "30", [emaFast, emaSlow], lookahead=barmerge.lookahead_off)
[tf60_fast, tf60_slow]   = request.security(syminfo.tickerid, "60", [emaFast, emaSlow], lookahead=barmerge.lookahead_off)
[tf240_fast, tf240_slow] = request.security(syminfo.tickerid, "240", [emaFast, emaSlow], lookahead=barmerge.lookahead_off)
[tfD_fast, tfD_slow]     = request.security(syminfo.tickerid, "D", [emaFast, emaSlow], lookahead=barmerge.lookahead_off)

bull5   = tf5_slow < tf5_fast
bull15  = tf15_slow < tf15_fast
bull30  = tf30_slow < tf30_fast
bull60  = tf60_slow < tf60_fast
bull240 = tf240_slow < tf240_fast
bullD   = tfD_slow < tfD_fast

tfBullish(string tf) =>
    switch tf
        "5"   => bull5
        "15"  => bull15
        "30"  => bull30
        "60"  => bull60
        "240" => bull240
        "D"   => bullD
        => false

trendRow(table t, int row, string name, bool isBull) =>
    table.cell(t, 0, row, name, text_color=color.black, bgcolor=color.new(#03f7ff, 0), text_size=size.small)
    table.cell(t, 1, row, isBull ? "Bullish" : "Bearish", text_color=color.black, bgcolor=isBull ? color.new(#00ff00, 0) : color.new(#FF0000, 0), text_size=size.small)

// === SCREENER DASHBOARD ===
if showScreener and barstate.islast
    var table screenerTable = table.new(getTablePosition(screenerPosition), 2, 3, bgcolor=color.new(color.rgb(33, 33, 33), 80), border_width=2, border_color=color.new(widgetBorderColor, 0), frame_width=3, frame_color=color.new(widgetBorderColor, 0))

    // Header row — BOLD
    table.cell(screenerTable, 0, 0, "𝗦𝗖𝗥𝗘𝗘𝗡𝗘𝗥", text_color=color.black, bgcolor=color.new(#03f7ff, 0), text_size=size.normal, text_halign=text.align_center)
    table.merge_cells(screenerTable, 0, 0, 1, 0)

    // Label row
    table.cell(screenerTable, 0, 1, "Long", text_color=color.black, bgcolor=color.new(#2dff03, 0), text_size=size.small, text_halign=text.align_center)
    table.cell(screenerTable, 1, 1, "Short", text_color=color.black, bgcolor=color.new(#ff0303, 0), text_size=size.small, text_halign=text.align_center)

    // Signal row
    longColor  = ribbonDir ? color.new(#1efd00, 0) : color.new(#ffd600, 0)
    shortColor = not ribbonDir ? color.new(#d50000, 0) : color.new(#ffd600, 0)
    longText   = ribbonDir ? "Long" : "No Signal"
    shortText  = not ribbonDir ? "Short" : "No Signal"
    table.cell(screenerTable, 0, 2, longText, text_color=color.black, bgcolor=longColor, text_size=size.small, text_halign=text.align_center)
    table.cell(screenerTable, 1, 2, shortText, text_color=color.black, bgcolor=shortColor, text_size=size.small, text_halign=text.align_center)

// === TREND ANALYSIS DASHBOARD ===
if showDashboard and barstate.islast
    var table dashboardTable = table.new(getTablePosition(dashboardPosition), 2, 8, bgcolor=color.new(color.rgb(33, 33, 33), 80), border_width=2, border_color=color.new(widgetBorderColor, 0), frame_width=3, frame_color=color.new(widgetBorderColor, 0))

    // Header
    table.cell(dashboardTable, 0, 0, "𝗧𝗥𝗘𝗡𝗗 𝗔𝗡𝗔𝗟𝗬𝗦𝗜𝗦", text_color=color.black, bgcolor=color.new(#03f7ff, 0), text_size=size.normal, text_halign=text.align_center)
    table.merge_cells(dashboardTable, 0, 0, 1, 0)

    // Combined status based on the three selected timeframes (2 of 3 wins)
    bullishCount = (tfBullish(combinedTrendTF1) ? 1 : 0) + (tfBullish(combinedTrendTF2) ? 1 : 0) + (tfBullish(combinedTrendTF3) ? 1 : 0)
    isOverallBullish = bullishCount >= 2
    combinedColor = isOverallBullish ? color.new(#00ff00, 0) : color.new(#FF0000, 0)
    statusEmoji = isOverallBullish ? "𝗕𝘂𝗹𝗹𝗶𝘀𝗵 🐂" : "𝗕𝗲𝗮𝗿𝗶𝘀𝗵 🐻"
    table.cell(dashboardTable, 0, 1, "𝗦𝗧𝗔𝗧𝗨𝗦", text_color=color.black, bgcolor=color.new(#03f7ff, 0), text_size=size.small)
    table.cell(dashboardTable, 1, 1, statusEmoji, text_color=color.black, bgcolor=combinedColor, text_size=size.small)

    // Individual timeframes
    trendRow(dashboardTable, 2, "5 Min", bull5)
    trendRow(dashboardTable, 3, "15 Min", bull15)
    trendRow(dashboardTable, 4, "30 Min", bull30)
    trendRow(dashboardTable, 5, "1 Hour", bull60)
    trendRow(dashboardTable, 6, "4 Hour", bull240)
    trendRow(dashboardTable, 7, "Daily", bullD)

// === MARKET ANALYSIS DASHBOARD ===
if showMarket and barstate.islast
    var table marketTable = table.new(position.bottom_left, 2, 7, bgcolor=color.new(color.rgb(33, 33, 33), 80), border_width=2, border_color=color.new(widgetBorderColor, 0), frame_width=3, frame_color=color.new(widgetBorderColor, 0))
    color headBg = color.new(#03f7ff, 0)
    color darkBg = color.new(#212121, 0)

    table.cell(marketTable, 0, 0, "𝗠𝗔𝗥𝗞𝗘𝗧 𝗔𝗡𝗔𝗟𝗬𝗦𝗜𝗦", text_color=color.black, bgcolor=headBg, text_size=size.normal, text_halign=text.align_center)
    table.merge_cells(marketTable, 0, 0, 1, 0)

    momentumText  = ribbonDir ? "UPTREND" : "DOWNTREND"
    momentumColor = ribbonDir ? color.new(#00c853, 0) : color.new(#d50000, 0)
    table.cell(marketTable, 0, 1, "Momentum", text_color=color.black, bgcolor=headBg, text_size=size.small)
    table.cell(marketTable, 1, 1, momentumText, text_color=color.black, bgcolor=momentumColor, text_size=size.small)

    bool trending = adx >= adxThreshold
    table.cell(marketTable, 0, 2, "Strength (ADX)", text_color=color.black, bgcolor=headBg, text_size=size.small)
    table.cell(marketTable, 1, 2, str.tostring(adx, "#.0") + (trending ? " Trending" : " Sideways"), text_color=color.black, bgcolor=trending ? color.new(#00c853, 0) : color.new(#ffd600, 0), text_size=size.small)

    float nearS = nearestSupply(supplyZones)
    float nearD = nearestDemand(demandZones)
    table.cell(marketTable, 0, 3, "Nearest Supply", text_color=color.black, bgcolor=headBg, text_size=size.small)
    table.cell(marketTable, 1, 3, na(nearS) ? "-" : str.tostring(nearS, format.mintick), text_color=color.white, bgcolor=color.new(supplyColor, 0), text_size=size.small)
    table.cell(marketTable, 0, 4, "Nearest Demand", text_color=color.black, bgcolor=headBg, text_size=size.small)
    table.cell(marketTable, 1, 4, na(nearD) ? "-" : str.tostring(nearD, format.mintick), text_color=color.white, bgcolor=color.new(demandColor, 0), text_size=size.small)

    // Honest scorecard over the loaded history: did TP1 come before SL?
    int closedTrades = tp1Wins + slLosses
    string rateText = closedTrades > 0 ? str.tostring(100.0 * tp1Wins / closedTrades, "#.0") + "% (" + str.tostring(tp1Wins) + "/" + str.tostring(closedTrades) + ")" : "-"
    table.cell(marketTable, 0, 5, "TP1 before SL", text_color=color.black, bgcolor=headBg, text_size=size.small)
    table.cell(marketTable, 1, 5, rateText, text_color=color.white, bgcolor=darkBg, text_size=size.small)

    table.cell(marketTable, 0, 6, "Volume", text_color=color.black, bgcolor=headBg, text_size=size.small)
    table.cell(marketTable, 1, 6, str.tostring(math.round(volume)), text_color=color.white, bgcolor=darkBg, text_size=size.small)
