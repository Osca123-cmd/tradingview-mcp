//@version=6
indicator("PIPS HUNTER", overlay=true, scale=scale.right, max_labels_count=500, max_lines_count=500, max_boxes_count=500, max_bars_back=500)

// === INPUTS ===
showRibbon = input.bool(true, "Show EMA Ribbon", group="EMA Settings")
ribbonMode = input.string("Dots", "Ribbon Style", options=["Dots", "Full Ribbon", "Both"], group="EMA Settings")
ema1Len = input.int(5, "EMA 1 Length", group="EMA Settings")
ema2Len = input.int(11, "EMA 2 Length", group="EMA Settings")
ema3Len = input.int(15, "EMA 3 Length", group="EMA Settings")
ema4Len = input.int(18, "EMA 4 Length", group="EMA Settings")
ema5Len = input.int(21, "EMA 5 Length", group="EMA Settings")
ema6Len = input.int(24, "EMA 6 Length", group="EMA Settings")
ema7Len = input.int(28, "EMA 7 Length", group="EMA Settings")
ema8Len = input.int(34, "EMA 8 Length", group="EMA Settings")

tpCount = input.int(4, "Number of Take Profits", minval=1, maxval=4, group="Trade Management")
atrrMultiplier = input.float(2, "ATR Multiplier for SL", group="Trade Management")
atrrTPFactor = input.float(1.0, "TP Multiplier (relative to SL)", group="Trade Management")
atrLen = input.int(14, "ATR Length", group="Trade Management")
showTP_SL_Lines = input.bool(true, "Show TP/SL Lines & Boxes", group="Trade Management")

// Market Structure Inputs
showSwings = input.bool(true, "Show Swing Labels (HH/HL/LH/LL)", group="Market Structure")
showBOS = input.bool(true, "Show BOS", group="Market Structure")
swingLen = input.int(3, "Swing Length", minval=1, group="Market Structure")
swingTextColor = input.color(#fff100, "Swing Label Color", group="Market Structure")
bosColor = input.color(color.white, "BOS Color", group="Market Structure")

// Supply & Demand Inputs
showZones = input.bool(false, "Show Old POI Zones (second zone set)", group="Supply & Demand", tooltip="The old POI zones now feed the main zone system (Zone Detection group), so they are off by default to avoid drawing every zone twice.")
zoneLookback = input.int(20, "Zone Candle Lookback", minval=1, maxval=100, group="Supply & Demand")
zoneWidth = input.float(0.3, "Zone Width (x ATR)", minval=0.05, step=0.05, group="Supply & Demand")
maxZones = input.int(6, "Max Active Zones", minval=1, maxval=20, group="Supply & Demand")
supplyColor = input.color(#f23645, "Supply Color", group="Supply & Demand")
demandColor = input.color(#089981, "Demand Color", group="Supply & Demand")
zoneFill = input.int(60, "Zone Transparency", minval=0, maxval=100, group="Supply & Demand")

// Dashboard Input
showDashboard = input.bool(true, "Show Trend Analysis Dashboard", group="Dashboard Settings")
dashboardPosition = input.string("Bottom Right", "Dashboard Position", options=["Top Left", "Top Right", "Bottom Left", "Bottom Right"], group="Dashboard Settings")
combinedTrendTF1 = input.string("5", "Trend Timeframe 1", options=["5", "15", "30", "60", "240", "D"], group="Dashboard Settings")
combinedTrendTF2 = input.string("15", "Trend Timeframe 2", options=["5", "15", "30", "60", "240", "D"], group="Dashboard Settings")
combinedTrendTF3 = input.string("60", "Trend Timeframe 3", options=["5", "15", "30", "60", "240", "D"], group="Dashboard Settings")
trendStrongAdx = input.float(25.0, "Strong Trend ADX", minval=1, step=0.5, group="Dashboard Settings", tooltip="ADX at or above this level is shown as Strong. Below the ADX Trending Level (Market Analysis Settings) a timeframe is shown as Sideways.")
trendFlatGap = input.float(0.1, "Flat EMA Gap (x ATR)", minval=0, step=0.05, group="Dashboard Settings", tooltip="In a sideways market, when EMA fast and slow are closer than this, the timeframe is shown as plain Sideways instead of Bullish/Bearish Sideways.")

// Market Analysis Input
showMarket = input.bool(true, "Show Market Analysis", group="Market Analysis Settings")
marketPosition = input.string("Bottom Left", "Market Analysis Position", options=["Top Left", "Top Right", "Bottom Left", "Bottom Right"], group="Market Analysis Settings")
showVolumeRow = input.bool(true, "Show Volume Row", group="Market Analysis Settings")
adxLen = input.int(14, "ADX Length", minval=1, group="Market Analysis Settings")
adxThreshold = input.float(20.0, "ADX Trending Level", minval=0, step=0.5, group="Market Analysis Settings", tooltip="ADX below this level is shown as Sideways.")
trendEmaLen = input.int(200, "Trend EMA Length (Entry Bias)", minval=1, group="Market Analysis Settings", tooltip="Only used by the Entry Bias row of the Market Analysis table. It does not change the entry signals.")

// Supply & demand zones (one zone system; feeds Price Position / Nearest Supply / Nearest Demand; never changes the entry signals)
maDrawZones   = input.bool(true, "Draw Zones On Chart", group="Zone Detection", tooltip="Draws the zones named in the Market Analysis table, so the prices in the table can be seen on the chart.")
maShowZones     = input.bool(true, "Track Supply & Demand For Market Analysis", group="Zone Detection")
useRejection  = input.bool(true, "Detect: Repeated Rejections (fastest)", group="Zone Detection", tooltip="Draws a zone as soon as several candles are held at the same level and close back away from it.")
rejMinTouches = input.int(2, "   Rejections Needed", minval=2, maxval=6, group="Zone Detection", tooltip="How many candles must be held at the same level. 2 = fastest, 3-4 = stricter.")
rejLookback   = input.int(8, "   Rejection Lookback (bars)", minval=3, maxval=30, group="Zone Detection")
rejTol        = input.float(0.15, "   Same-Level Tolerance (x ATR)", minval=0.02, step=0.01, group="Zone Detection")
useStructure  = input.bool(true, "Detect: Trend Structure (fresh zones in strong trends)", group="Zone Detection", tooltip="When price closes at a new low, the last pullback high becomes a fresh supply zone (and the reverse for demand). Keeps producing new zoneList while a strong trend runs.")
structLen     = input.int(10, "   Structure Length (bars)", minval=4, maxval=50, group="Zone Detection")
useBase       = input.bool(true, "Detect: Base + Impulse Candle", group="Zone Detection", tooltip="The small candle(s) right before an explosive candle. Appears when the explosive candle closes.")
impulseCandle = input.float(1.3, "   Impulse Candle Body (x ATR)", minval=0.5, step=0.1, group="Zone Detection")
usePivot      = input.bool(true, "Detect: Swing Pivots", group="Zone Detection", tooltip="Confirmed swing highs/lows. Appears Swing Length bars after the swing.")
usePoi        = input.bool(true, "Detect: POI (last opposite candle before BOS)", group="Zone Detection", tooltip="The same idea as the old POI zones, but sized and tracked together with the other zones.")
maSwingLen      = input.int(3, "   Swing Length", minval=2, maxval=50, group="Zone Detection")
impulseMult   = input.float(1.5, "   Minimum Move Away (x ATR)", minval=0, step=0.1, group="Zone Detection")
zoneMinWidth  = input.float(0.15, "Minimum Zone Height (x ATR)", minval=0.05, step=0.05, group="Zone Detection")
zoneMaxWidth  = input.float(0.5, "Maximum Zone Height (x ATR)", minval=0.1, step=0.1, group="Zone Detection", tooltip="Caps how thick a zone can be. Lower = tighter, more precise zoneList.")
maMaxZones      = input.int(2, "Zones Drawn Per Side (nearest to price)", minval=1, maxval=20, group="Zone Detection")
maxStored     = input.int(30, "Zones Tracked Per Side", minval=5, maxval=100, group="Zone Detection", tooltip="Zones remembered in the background. Only the nearest ones are drawn; the rest appear automatically when price moves toward them.")
flipZones     = input.bool(true, "Flip Broken Zones (demand becomes supply, and reverse)", group="Zone Detection")
breakMode     = input.string("Close", "Zone Broken By", options=["Close", "Wick"], group="Zone Detection")
showBroken    = input.bool(false, "Keep Broken Zones (grey)", group="Zone Detection")
zoneExtend    = input.int(20, "Extend Zones Right (bars)", minval=1, maxval=200, group="Zone Detection")

// Unified Border Color Input
widgetBorderColor = input.color(#000000, "Screener & Dashboard border's colors", group="Widget Style", tooltip="Changes all borders and outlines for both screener and dashboard")

// === SCREENER INPUTS ===
showScreener = input.bool(true, "Show Screener", group="Screener Settings")
screenerPosition = input.string("Top Right", "Screener Position", options=["Top Left", "Top Right", "Bottom Left", "Bottom Right"], group="Screener Settings")

// === TYPES ===
type Zone
    box b
    label tag
    label poi
    int dir
    float top
    float bot

// === SHARED STATE ===
atr = ta.atr(atrLen)
[diPlus, diMinus, adx] = ta.dmi(adxLen, adxLen)
maEmaTrend = ta.ema(close, trendEmaLen)
var array<Zone> zones = array.new<Zone>()

// === HELPER FUNCTIONS ===
getTablePosition(pos) =>
    switch pos
        "Top Left"     => position.top_left
        "Top Right"    => position.top_right
        "Bottom Left"  => position.bottom_left
        "Bottom Right" => position.bottom_right
        => position.top_right

getTFLabel(tf) =>
    switch tf
        "5"   => "5 Min"
        "15"  => "15 Min"
        "30"  => "30 Min"
        "60"  => "1 Hour"
        "240" => "4 Hour"
        "D"   => "Daily"
        => tf

deleteZone(Zone z) =>
    box.delete(z.b)
    label.delete(z.tag)
    label.delete(z.poi)

// Last opposite candle before the breakout candle becomes the zone
newZone(int dir) =>
    int idx = na
    for i = 1 to zoneLookback
        if (dir > 0 and close[i] < open[i]) or (dir < 0 and close[i] > open[i])
            idx := i
            break
    Zone z = na
    if not na(idx) and not na(atr)
        float zTop = dir > 0 ? low[idx] + atr * zoneWidth : high[idx]
        float zBot = dir > 0 ? low[idx] : high[idx] - atr * zoneWidth
        // Skip a zone that overlaps an active zone on the same side
        bool overlaps = false
        if array.size(zones) > 0
            for i = 0 to array.size(zones) - 1
                Zone other = array.get(zones, i)
                if other.dir == dir and zBot <= other.top and zTop >= other.bot
                    overlaps := true
                    break
        if not overlaps
            color zCol = dir > 0 ? demandColor : supplyColor
            float zMid = (zTop + zBot) / 2
            box zBox = box.new(bar_index - idx, zTop, bar_index, zBot, border_color=color.new(zCol, 30), bgcolor=color.new(zCol, zoneFill), extend=extend.right)
            label zTag = label.new(bar_index + 10, zMid, dir > 0 ? "DEMAND" : "SUPPLY", style=label.style_none, textcolor=color.white, size=size.small)
            label zPoi = label.new(bar_index - idx, zMid, "POI", style=label.style_none, textcolor=color.white, size=size.small)
            z := Zone.new(zBox, zTag, zPoi, dir, zTop, zBot)
    z

// === CALCULATIONS ===
ema1 = ta.ema(close, ema1Len)
ema2 = ta.ema(close, ema2Len)
ema3 = ta.ema(close, ema3Len)
ema4 = ta.ema(close, ema4Len)
ema5 = ta.ema(close, ema5Len)
ema6 = ta.ema(close, ema6Len)
ema7 = ta.ema(close, ema7Len)
ema8 = ta.ema(close, ema8Len)

// Determine ribbon direction
ribbonDir = ema8 < ema2

// Signal generation for crossovers
longSignal = ta.crossover(ema2, ema8)
shortSignal = ta.crossover(ema8, ema2)

// === PLOTS - EMA Ribbon ===
ribbonColor = ribbonDir ? color.rgb(78, 247, 0) : color.rgb(250, 0, 0)
lineColor = color.new(ribbonColor, 50)
dotDisplay = showRibbon and ribbonMode != "Full Ribbon" ? display.all : display.none
lineDisplay = showRibbon and ribbonMode != "Dots" ? display.all : display.none

plot(ema1, color=lineColor, display=lineDisplay, title="EMA 1")
plot(ema2, color=lineColor, display=lineDisplay, title="EMA 2 Line")
plot(ema3, color=lineColor, display=lineDisplay, title="EMA 3")
plot(ema4, color=lineColor, display=lineDisplay, title="EMA 4")
plot(ema5, color=lineColor, display=lineDisplay, title="EMA 5")
plot(ema6, color=lineColor, display=lineDisplay, title="EMA 6")
plot(ema7, color=lineColor, display=lineDisplay, title="EMA 7")
plot(ema8, color=lineColor, display=lineDisplay, title="EMA 8")
plot(ema2, color=ribbonColor, linewidth=2, style=plot.style_circles, display=dotDisplay, title="EMA 2")

// === MARKET STRUCTURE ===
var float lastPH = na
var float lastPL = na
var int lastPHBar = na
var int lastPLBar = na
var bool phBroken = true
var bool plBroken = true
var int structDir = 0
var int structBar = na

ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)

if not na(ph)
    if showSwings
        label.new(bar_index - swingLen, ph, na(lastPH) or ph > lastPH ? "HH" : "LH", yloc=yloc.abovebar, style=label.style_none, textcolor=swingTextColor, size=size.small)
    lastPH := ph
    lastPHBar := bar_index - swingLen
    phBroken := false

if not na(pl)
    if showSwings
        label.new(bar_index - swingLen, pl, na(lastPL) or pl > lastPL ? "HL" : "LL", yloc=yloc.belowbar, style=label.style_none, textcolor=swingTextColor, size=size.small)
    lastPL := pl
    lastPLBar := bar_index - swingLen
    plBroken := false

bullBreak = not phBroken and close > lastPH
bearBreak = not plBroken and close < lastPL

if bullBreak
    phBroken := true
    structDir := 1
    structBar := bar_index
    if showBOS
        line.new(lastPHBar, lastPH, bar_index, lastPH, color=bosColor, width=1)
        label.new(int(math.avg(lastPHBar, bar_index)), lastPH, "BOS", style=label.style_none, textcolor=bosColor, size=size.small)

if bearBreak
    plBroken := true
    structDir := -1
    structBar := bar_index
    if showBOS
        line.new(lastPLBar, lastPL, bar_index, lastPL, color=bosColor, width=1)
        label.new(int(math.avg(lastPLBar, bar_index)), lastPL, "BOS", style=label.style_none, textcolor=bosColor, size=size.small)

// === SUPPLY & DEMAND ZONES ===
if showZones and bullBreak
    Zone demandZone = newZone(1)
    if not na(demandZone)
        array.push(zones, demandZone)

if showZones and bearBreak
    Zone supplyZone = newZone(-1)
    if not na(supplyZone)
        array.push(zones, supplyZone)

// Remove zones once price closes through them
if array.size(zones) > 0
    for i = array.size(zones) - 1 to 0
        Zone z = array.get(zones, i)
        if (z.dir > 0 and close < z.bot) or (z.dir < 0 and close > z.top)
            deleteZone(z)
            array.remove(zones, i)

while array.size(zones) > maxZones
    deleteZone(array.shift(zones))

// Keep the SUPPLY/DEMAND text just right of the last bar
if barstate.islast and array.size(zones) > 0
    for i = 0 to array.size(zones) - 1
        label.set_x(array.get(zones, i).tag, bar_index + 10)

// === MARKET ANALYSIS ZONE TRACKER (does not affect entry signals) ===
type MaZone
    box   bx
    float top
    float bottom
    bool  isSupply
    int   tests = 0
    bool  inside = false
    bool  flipped = false

var array<MaZone> maSupplyZones = array.new<MaZone>()
var array<MaZone> maDemandZones = array.new<MaZone>()

zoneText(MaZone z) =>
    (z.isSupply ? "SUPPLY" : "DEMAND") + (z.flipped ? " (flip)" : "") + (z.tests > 0 ? " • test " + str.tostring(z.tests) : "")

zoneOverlaps(array<MaZone> zoneList, float top, float bottom) =>
    bool res = false
    for z in zoneList
        if top >= z.bottom and bottom <= z.top
            res := true
            break
    res

// Adds a zone. If it overlaps an existing zone on the same side, the existing zone is kept
// (and widened to cover both when that stays within the maximum height) instead of stacking duplicates.
addZone(array<MaZone> zoneList, float top, float bottom, int leftBar, bool isSupply, float maxHeight) =>
    bool merged = false
    for z in zoneList
        if top >= z.bottom and bottom <= z.top
            merged := true
            float newTop = math.max(top, z.top)
            float newBottom = math.min(bottom, z.bottom)
            if newTop - newBottom <= maxHeight
                z.top := newTop
                z.bottom := newBottom
                box.set_top(z.bx, newTop)
                box.set_bottom(z.bx, newBottom)
            break
    if not merged
        color c = isSupply ? supplyColor : demandColor
        box b = box.new(leftBar, top, bar_index + zoneExtend, bottom, border_color=color.new(c, 40), border_width=1, bgcolor=color.new(c, 80), text=isSupply ? "SUPPLY" : "DEMAND", text_color=color.new(c, 0), text_size=size.small, text_halign=text.align_right, text_valign=text.align_center)
        zoneList.push(MaZone.new(b, top, bottom, isSupply))
        if zoneList.size() > maxStored
            MaZone old = zoneList.shift()
            box.delete(old.bx)
    not merged

// Tracks every stored zone on every bar: counts retests, and retires or flips broken zoneList.
// Returns [price is inside a zone, a zone was freshly tested on this bar]
updateZones(array<MaZone> zoneList, array<MaZone> other, bool isSupply) =>
    bool priceInside = false
    bool newTest = false
    int i = zoneList.size() - 1
    while i >= 0
        MaZone z = zoneList.get(i)
        bool broken = false
        if breakMode == "Close"
            // only a finished candle can break a zone, so zoneList do not flicker on a live candle
            broken := barstate.isconfirmed and (isSupply ? close > z.top : close < z.bottom)
        else
            broken := isSupply ? high > z.top : low < z.bottom
        if broken
            zoneList.remove(i)
            if flipZones and not z.flipped and not zoneOverlaps(other, z.top, z.bottom)
                // a broken demand becomes supply (and reverse), once
                z.isSupply := not isSupply
                z.flipped := true
                z.tests := 0
                z.inside := true
                other.push(z)
            else if showBroken
                box.set_right(z.bx, bar_index)
                box.set_bgcolor(z.bx, color.new(color.gray, 90))
                box.set_border_color(z.bx, color.new(color.gray, 70))
                box.set_text(z.bx, "")
            else
                box.delete(z.bx)
        else
            bool touching = isSupply ? high >= z.bottom : low <= z.top
            if touching and not z.inside
                z.tests += 1
                newTest := true
            z.inside := touching
            if close <= z.top and close >= z.bottom
                priceInside := true
        i -= 1
    [priceInside, newTest]

// Draws only the zoneList nearest to price; the others stay tracked but hidden.
renderZones(array<MaZone> zoneList, bool isSupply) =>
    if zoneList.size() > 0
        array<float> keys = array.new<float>()
        for z in zoneList
            keys.push(isSupply ? z.bottom : -z.top)
        array<int> ranked = array.sort_indices(keys, order.ascending)
        color c = isSupply ? supplyColor : demandColor
        for [rank, idx] in ranked
            MaZone z = zoneList.get(idx)
            if maDrawZones and rank < maMaxZones
                box.set_right(z.bx, bar_index + zoneExtend)
                if bar_index - box.get_left(z.bx) > 4000
                    box.set_left(z.bx, bar_index - 4000)
                box.set_bgcolor(z.bx, color.new(c, z.tests == 0 ? 78 : 88))
                box.set_border_color(z.bx, color.new(c, 40))
                box.set_text_color(z.bx, color.new(c, 0))
                box.set_text(z.bx, zoneText(z))
            else
                box.set_bgcolor(z.bx, color.new(c, 100))
                box.set_border_color(z.bx, color.new(c, 100))
                box.set_text(z.bx, "")

// Nearest zone to current price on one side (na when there is none)
nearestZone(array<MaZone> zoneList, bool isSupply) =>
    MaZone res = na
    for z in zoneList
        if na(res)
            res := z
        else if isSupply ? z.bottom < res.bottom : z.top > res.top
            res := z
    res

atrRef = nz(atr[1], atr)

// --- Detection 1: repeated rejections (several candles held at the same level) ---
// Returns [level, nearest candle-body edge, number of held candles, bars back to the first one]
rejection(bool isTop, int len, float tol) =>
    float level = isTop ? high : low
    for k = 1 to len - 1
        level := isTop ? math.max(level, high[k]) : math.min(level, low[k])
    int count = 0
    int firstOff = 0
    float edge = na
    for k = 0 to len - 1
        bool touch = false
        if isTop
            touch := high[k] >= level - tol and close[k] < level - tol
        else
            touch := low[k] <= level + tol and close[k] > level + tol
        if touch
            count += 1
            firstOff := k
            float body = isTop ? math.max(open[k], close[k]) : math.min(open[k], close[k])
            if na(edge)
                edge := body
            else
                edge := isTop ? math.max(edge, body) : math.min(edge, body)
    [level, edge, count, firstOff]

[rejTopLevel, rejTopEdge, rejTopCount, rejTopOff] = rejection(true, rejLookback, atrRef * rejTol)
[rejBotLevel, rejBotEdge, rejBotCount, rejBotOff] = rejection(false, rejLookback, atrRef * rejTol)

// --- Detection 2: trend structure (the pullback that came before a new closing high/low) ---
lowestPrev  = ta.lowest(low, structLen)[1]
highestPrev = ta.highest(high, structLen)[1]
int hhOff = nz(-ta.highestbars(high, structLen), 0)
int llOff = nz(-ta.lowestbars(low, structLen), 0)
breakDown = close < lowestPrev
breakUp   = close > highestPrev
// the extreme must be a real pullback peak/trough, not just the oldest candle of a one-way move
peakOK   = hhOff >= 1 and high[hhOff] > high[hhOff + 1] and high[hhOff] > high[hhOff + 2]
troughOK = llOff >= 1 and low[llOff] < low[llOff + 1] and low[llOff] < low[llOff + 2]
structTop      = high[hhOff]
structTopBody  = math.min(open[hhOff], close[hhOff])
structBot      = low[llOff]
structBotBody  = math.max(open[llOff], close[llOff])

// --- Detection 3: base + impulse (the candles right before an explosive candle) ---
baseInfo() =>
    float bTop = math.max(open[1], close[1])
    float bBot = math.min(open[1], close[1])
    float wHi = high[1]
    float wLo = low[1]
    int bars = 1
    bool small1 = math.abs(close[1] - open[1]) <= atrRef * 0.75
    if small1
        for k = 2 to 3
            if math.abs(close[k] - open[k]) <= atrRef * 0.6
                bTop := math.max(bTop, math.max(open[k], close[k]))
                bBot := math.min(bBot, math.min(open[k], close[k]))
                wHi := math.max(wHi, high[k])
                wLo := math.min(wLo, low[k])
                bars := k
            else
                break
    [bTop, bBot, wHi, wLo, bars, small1]

[baseTop, baseBot, baseHi, baseLo, baseBars, baseSmall] = baseInfo()
bodySize    = math.abs(close - open)
impulseUp   = close > open and bodySize >= atrRef * impulseCandle and (baseSmall or close[1] < open[1])
impulseDown = close < open and bodySize >= atrRef * impulseCandle and (baseSmall or close[1] > open[1])

// --- Detection 4: confirmed swing pivots (appear maSwingLen bars later) ---
pivotHigh = ta.pivothigh(high, maSwingLen, maSwingLen)
pivotLow  = ta.pivotlow(low, maSwingLen, maSwingLen)
lowestSince  = ta.lowest(low, maSwingLen)
highestSince = ta.highest(high, maSwingLen)

// --- Detection 5: POI, the last opposite candle before a break of structure ---
poiCandle(int dir) =>
    int idx = na
    for i = 1 to zoneLookback
        if (dir > 0 and close[i] < open[i]) or (dir < 0 and close[i] > open[i])
            idx := i
            break
    float cHigh = na
    float cLow = na
    float cBodyTop = na
    float cBodyBot = na
    if not na(idx)
        cHigh := high[idx]
        cLow := low[idx]
        cBodyTop := math.max(open[idx], close[idx])
        cBodyBot := math.min(open[idx], close[idx])
    [cHigh, cLow, cBodyTop, cBodyBot, idx]

[poiBullHigh, poiBullLow, poiBullBodyTop, poiBullBodyBot, poiBullOff] = poiCandle(1)
[poiBearHigh, poiBearLow, poiBearBodyTop, poiBearBodyBot, poiBearOff] = poiCandle(-1)

bool inSupply = false
bool inDemand = false
bool supplyTested = false
bool demandTested = false
bool newSupplyZone = false
bool newDemandZone = false

if maShowZones
    [_inS, _testS] = updateZones(maSupplyZones, maDemandZones, true)
    [_inD, _testD] = updateZones(maDemandZones, maSupplyZones, false)
    inSupply := _inS
    inDemand := _inD
    supplyTested := _testS
    demandTested := _testD

    // New zoneList are only created from finished candles
    if barstate.isconfirmed and not na(atr)
        float minH = atr * zoneMinWidth
        float maxH = atr * zoneMaxWidth

        // 1. Repeated rejections
        if useRejection and rejTopCount >= rejMinTouches and not na(rejTopEdge)
            float rTop = rejTopLevel
            float rBottom = math.max(math.min(rejTopEdge, rTop - minH), rTop - maxH)
            if close < rBottom
                if addZone(maSupplyZones, rTop, rBottom, bar_index - rejTopOff, true, maxH)
                    newSupplyZone := true

        if useRejection and rejBotCount >= rejMinTouches and not na(rejBotEdge)
            float rLow = rejBotLevel
            float rHigh = math.min(math.max(rejBotEdge, rLow + minH), rLow + maxH)
            if close > rHigh
                if addZone(maDemandZones, rHigh, rLow, bar_index - rejBotOff, false, maxH)
                    newDemandZone := true

        // 2. Trend structure
        if useStructure and breakDown and peakOK
            float tTop = structTop
            float tBottom = math.max(math.min(structTopBody, tTop - minH), tTop - maxH)
            if close < tBottom
                if addZone(maSupplyZones, tTop, tBottom, bar_index - hhOff, true, maxH)
                    newSupplyZone := true

        if useStructure and breakUp and troughOK
            float uBottom = structBot
            float uTop = math.min(math.max(structBotBody, uBottom + minH), uBottom + maxH)
            if close > uTop
                if addZone(maDemandZones, uTop, uBottom, bar_index - llOff, false, maxH)
                    newDemandZone := true

        // 3. Base + impulse
        if useBase and impulseDown
            float sTop = math.max(baseHi, high)
            float sBottom = math.max(math.min(baseBot, sTop - minH), sTop - maxH)
            if close < sBottom
                if addZone(maSupplyZones, sTop, sBottom, bar_index - baseBars, true, maxH)
                    newSupplyZone := true

        if useBase and impulseUp
            float dBottom = math.min(baseLo, low)
            float dTop = math.min(math.max(baseTop, dBottom + minH), dBottom + maxH)
            if close > dTop
                if addZone(maDemandZones, dTop, dBottom, bar_index - baseBars, false, maxH)
                    newDemandZone := true

        // 4. Swing pivots
        if usePivot and not na(pivotHigh)
            float pTop = pivotHigh
            float pBody = math.min(open[maSwingLen], close[maSwingLen])
            float pBottom = math.max(math.min(pBody, pTop - minH), pTop - maxH)
            if pTop - lowestSince >= atr * impulseMult and close < pBottom
                if addZone(maSupplyZones, pTop, pBottom, bar_index - maSwingLen, true, maxH)
                    newSupplyZone := true

        if usePivot and not na(pivotLow)
            float qBottom = pivotLow
            float qBody = math.max(open[maSwingLen], close[maSwingLen])
            float qTop = math.min(math.max(qBody, qBottom + minH), qBottom + maxH)
            if highestSince - qBottom >= atr * impulseMult and close > qTop
                if addZone(maDemandZones, qTop, qBottom, bar_index - maSwingLen, false, maxH)
                    newDemandZone := true

        // 5. POI at a break of structure
        if usePoi and bearBreak and not na(poiBearOff)
            float oTop = poiBearHigh
            float oBottom = math.max(math.min(poiBearBodyBot, oTop - minH), oTop - maxH)
            if close < oBottom
                if addZone(maSupplyZones, oTop, oBottom, bar_index - poiBearOff, true, maxH)
                    newSupplyZone := true

        if usePoi and bullBreak and not na(poiBullOff)
            float oBottom = poiBullLow
            float oTop = math.min(math.max(poiBullBodyTop, oBottom + minH), oBottom + maxH)
            if close > oTop
                if addZone(maDemandZones, oTop, oBottom, bar_index - poiBullOff, false, maxH)
                    newDemandZone := true

    if barstate.islast
        renderZones(maSupplyZones, true)
        renderZones(maDemandZones, false)

// === TRADE STATE VARIABLES ===
var label signalLabel = na
var array<float> currentTPLevels = array.new<float>()
var array<bool> tpHitStatus = array.new<bool>()
var float currentSLLevel = na
var int tradeDirection = 0
var bool tradeActive = false
var int tradeEndX = na
var array<line> tpLines = array.new<line>()
var line slLine = na
var line entryLine = na
var array<label> rightLabels = array.new<label>()
var float plotEntryLevelVal = na
var float plotSLLevelVal = na
var float plotTP4LevelVal = na
var box tpBox = na
var box slBox = na

// === SIGNAL HANDLING ===
if (longSignal or shortSignal)
    // Delete previous drawings
    if not na(signalLabel)
        label.delete(signalLabel)

    if array.size(tpLines) > 0
        for i = 0 to array.size(tpLines) - 1
            line.delete(array.get(tpLines, i))
    array.clear(tpLines)

    if not na(slLine)
        line.delete(slLine)
        slLine := na

    if not na(entryLine)
        line.delete(entryLine)
        entryLine := na

    if array.size(rightLabels) > 0
        for i = 0 to array.size(rightLabels) - 1
            label.delete(array.get(rightLabels, i))
    array.clear(rightLabels)

    if not na(tpBox)
        box.delete(tpBox)
    tpBox := na

    if not na(slBox)
        box.delete(slBox)
    slBox := na

    // Setup new trade state
    tradeActive := true
    tradeEndX := na
    tradeDirection := longSignal ? 1 : -1
    entry = close
    currentSLLevel := entry - tradeDirection * atr * atrrMultiplier

    // Calculate and store TP Levels
    array.clear(currentTPLevels)
    array.clear(tpHitStatus)
    for i = 1 to tpCount
        tp = entry + tradeDirection * atr * atrrMultiplier * atrrTPFactor * i
        array.push(currentTPLevels, tp)
        array.push(tpHitStatus, false)

    // Update plot levels for background filling
    plotEntryLevelVal := entry
    plotSLLevelVal := currentSLLevel
    plotTP4LevelVal := array.last(currentTPLevels)

    // Create BUY/SELL Signal Label
    signalLabel := label.new(bar_index,
                             y=tradeDirection > 0 ? low : high,
                             text=tradeDirection > 0 ? "Smart Buy" : "Smart Sell",
                             style=tradeDirection > 0 ? label.style_label_up : label.style_label_down,
                             color=tradeDirection > 0 ? color.new(#00c853,0) : color.new(#d50000,0),
                             textcolor=color.white,
                             size=size.normal)

    // Create Horizontal TP/SL/Entry Lines & Right-Side Labels
    int xRightInitial = bar_index + 10

    if showTP_SL_Lines
        // Create Entry line and label
        entryRightLabel = label.new(xRightInitial, entry, "ENTRY : " + str.tostring(entry, format.mintick), style=label.style_label_left, color=#fff100, textcolor=color.black, size=size.normal)
        array.push(rightLabels, entryRightLabel)
        entryLine := line.new(bar_index, entry, xRightInitial, entry, color=#fff100, style=line.style_solid, width=2)

        // Create TP lines and labels
        for i = 0 to array.size(currentTPLevels) - 1
            yVal = array.get(currentTPLevels, i)
            tpLine = line.new(bar_index, yVal, xRightInitial, yVal, color=#00ff00, style=line.style_solid, width=2)
            array.push(tpLines, tpLine)

            tpLabelText = "TP " + str.tostring(i + 1) + " : " + str.tostring(yVal, format.mintick)
            tpRightLabel = label.new(xRightInitial, yVal, tpLabelText, style=label.style_label_left, color=#00ff00, textcolor=color.black, size=size.normal)
            array.push(rightLabels, tpRightLabel)
//join telegram @traderschatroom88
        // Create SL line and label
        slLine := line.new(bar_index, currentSLLevel, xRightInitial, currentSLLevel, color=color.red, style=line.style_solid, width=2)
        slRightLabel = label.new(xRightInitial, currentSLLevel, "SL : " + str.tostring(currentSLLevel, format.mintick), style=label.style_label_left, color=color.red, textcolor=color.white, size=size.normal)
        array.push(rightLabels, slRightLabel)

        // Create Box objects for background filling
        tpBox := box.new(left=bar_index,
                         top=math.max(entry, plotTP4LevelVal),
                         bottom=math.min(entry, plotTP4LevelVal),
                         right=xRightInitial,
                         bgcolor=color.new(#089981, 80),
                         border_color=color.rgb(0, 0, 0, 100))

        slBox := box.new(left=bar_index,
                         top=math.max(entry, plotSLLevelVal),
                         bottom=math.min(entry, plotSLLevelVal),
                         right=xRightInitial,
                         bgcolor=color.new(#f23645, 80),
                         border_color=color.rgb(0, 0, 0, 100))

// === TRADE MANAGEMENT ===
// Moves every drawing of the current trade to a new right edge
setTradeRight(int xRight) =>
    if not na(entryLine)
        line.set_x2(entryLine, xRight)
    if array.size(tpLines) > 0
        for i = 0 to array.size(tpLines) - 1
            line.set_x2(array.get(tpLines, i), xRight)
    if not na(slLine)
        line.set_x2(slLine, xRight)
    if array.size(rightLabels) > 0
        for i = 0 to array.size(rightLabels) - 1
            label.set_x(array.get(rightLabels, i), xRight)
    if not na(tpBox)
        box.set_right(tpBox, xRight)
    if not na(slBox)
        box.set_right(slBox, xRight)

if tradeActive
    if showTP_SL_Lines
        setTradeRight(bar_index + 10)

    // Stop Loss hit check
    slHit = (tradeDirection > 0 and low <= currentSLLevel) or (tradeDirection < 0 and high >= currentSLLevel)

    // Track individual TP hits
    bool allTPsHit = true
    for i = 0 to array.size(currentTPLevels) - 1
        tpLevel = array.get(currentTPLevels, i)
        if (tradeDirection > 0 and high >= tpLevel) or (tradeDirection < 0 and low <= tpLevel)
            array.set(tpHitStatus, i, true)
        if not array.get(tpHitStatus, i)
            allTPsHit := false

    if slHit or allTPsHit
        tradeActive := false
        tradeEndX := bar_index
        if showTP_SL_Lines
            setTradeRight(tradeEndX + 10)

// === MARKET ANALYSIS SCORECARD (only reads the trade state above, never changes it) ===
var int tp1Wins = 0
var int slLosses = 0
var bool maOutcomeCounted = false
var bool maWasActive = false
var bool maTp1Prev = false
if longSignal or shortSignal
    maOutcomeCounted := false
    maTp1Prev := false
bool maTp1Hit = array.size(tpHitStatus) > 0 and array.get(tpHitStatus, 0)
bool maEndedNow = maWasActive and not tradeActive
bool maSlTouched = tradeDirection > 0 ? low <= currentSLLevel : high >= currentSLLevel
if not maOutcomeCounted
    bool maFirstTp1Bar = maTp1Hit and not maTp1Prev
    if maEndedNow and maSlTouched and (not maTp1Hit or maFirstTp1Bar)
        // stop loss came before TP1 (SL and TP1 on the same candle is counted as a loss, the safe assumption)
        slLosses += 1
        maOutcomeCounted := true
    else if maTp1Hit
        tp1Wins += 1
        maOutcomeCounted := true
maTp1Prev := maTp1Hit
maWasActive := tradeActive

// === ALERTS ===
alertcondition(longSignal, title="Long EMA Cross", message="Long EMA Crossover Signal")
alertcondition(shortSignal, title="Short EMA Cross", message="Short Crossover Signal")
alertcondition(bullBreak, title="Bullish BOS", message="Bullish Break of Structure")
alertcondition(bearBreak, title="Bearish BOS", message="Bearish Break of Structure")

// Multi-timeframe data for trend analysis
trendCalc() =>
    float e2 = ta.ema(close, ema2Len)
    float e8 = ta.ema(close, ema8Len)
    [dPlus, dMinus, ax] = ta.dmi(adxLen, adxLen)
    float a = ta.atr(atrLen)
    [e2, e8, ax, ax[1], a]

tfTrend(string tf) =>
    request.security(syminfo.tickerid, tf, trendCalc(), lookahead=barmerge.lookahead_off)

// Trend code: 3 Strong Bullish, 2 Bullish, 1 Bullish Sideways, 0 Sideways, -1 Bearish Sideways, -2 Bearish, -3 Strong Bearish
trendCode(float fast, float slow, float adxV, float atrV) =>
    int code = 0
    if not na(fast) and not na(slow) and not na(adxV)
        float gap = nz(atrV) > 0 ? math.abs(fast - slow) / atrV : 0.0
        int dir = fast > slow ? 1 : -1
        if adxV < adxThreshold
            code := gap < trendFlatGap ? 0 : dir
        else
            code := adxV >= trendStrongAdx ? dir * 3 : dir * 2
    code

codeScore(int c) =>
    c == 3 ? 2.0 : c == 2 ? 1.0 : c == 1 ? 0.5 : c == -1 ? -0.5 : c == -2 ? -1.0 : c == -3 ? -2.0 : 0.0

[tf1Fast, tf1Slow, tf1Adx, tf1AdxPrev, tf1Atr] = tfTrend(combinedTrendTF1)
[tf2Fast, tf2Slow, tf2Adx, tf2AdxPrev, tf2Atr] = tfTrend(combinedTrendTF2)
[tf3Fast, tf3Slow, tf3Adx, tf3AdxPrev, tf3Atr] = tfTrend(combinedTrendTF3)

tf1Code = trendCode(tf1Fast, tf1Slow, tf1Adx, tf1Atr)
tf2Code = trendCode(tf2Fast, tf2Slow, tf2Adx, tf2Atr)
tf3Code = trendCode(tf3Fast, tf3Slow, tf3Adx, tf3Atr)

trendAvg = (codeScore(tf1Code) + codeScore(tf2Code) + codeScore(tf3Code)) / 3
int trendBulls = (tf1Code > 0 ? 1 : 0) + (tf2Code > 0 ? 1 : 0) + (tf3Code > 0 ? 1 : 0)
int trendBears = (tf1Code < 0 ? 1 : 0) + (tf2Code < 0 ? 1 : 0) + (tf3Code < 0 ? 1 : 0)

int trendVerdictCode = 0
string trendVerdictText = "SIDEWAYS"
if trendBulls > 0 and trendBears > 0 and math.abs(trendAvg) < 0.75
    // timeframes disagree
    trendVerdictCode := 0
    trendVerdictText := trendAvg > 0.1 ? "MIXED (lean BULL)" : trendAvg < -0.1 ? "MIXED (lean BEAR)" : "MIXED"
else if trendAvg >= 1.5
    trendVerdictCode := 3
    trendVerdictText := "STRONG BULLISH"
else if trendAvg >= 0.75
    trendVerdictCode := 2
    trendVerdictText := "BULLISH"
else if trendAvg >= 0.25
    trendVerdictCode := 1
    trendVerdictText := "BULLISH SIDEWAYS"
else if trendAvg > -0.25
    trendVerdictCode := 0
    trendVerdictText := "SIDEWAYS"
else if trendAvg > -0.75
    trendVerdictCode := -1
    trendVerdictText := "BEARISH SIDEWAYS"
else if trendAvg > -1.5
    trendVerdictCode := -2
    trendVerdictText := "BEARISH"
else
    trendVerdictCode := -3
    trendVerdictText := "STRONG BEARISH"

// === SCREENER DASHBOARD ===
if showScreener and barstate.islast
    var table screenerTable = table.new(getTablePosition(screenerPosition), 2, 3,
         bgcolor = color.new(color.rgb(33, 33, 33), 80),
         border_width = 2, border_color = color.new(widgetBorderColor, 0),
         frame_width = 3, frame_color = color.new(widgetBorderColor, 0))

    // Header row — BOLD
    table.cell(screenerTable, 0, 0, "𝗦𝗖𝗥𝗘𝗘𝗡𝗘𝗥", text_color=color.black, bgcolor=color.new(#03f7ff,0), text_size=size.normal, text_halign=text.align_center)
    table.merge_cells(screenerTable, 0, 0, 1, 0)

    // Label row
    table.cell(screenerTable, 0, 1, "Long",  text_color=color.black, bgcolor=color.new(#2dff03, 0), text_size=size.small, text_halign=text.align_center)
    table.cell(screenerTable, 1, 1, "Short", text_color=color.black, bgcolor=color.new(#ff0303, 0), text_size=size.small, text_halign=text.align_center)

    // Signal row
    longColor  = ribbonDir ? color.new(#1efd00, 0) : color.new(#ffd600,0)
    shortColor = not ribbonDir ? color.new(#d50000,0) : color.new(#ffd600,0)
    longText   = ribbonDir ? "Long" : "No Signal"
    shortText  = not ribbonDir ? "Short" : "No Signal"
    table.cell(screenerTable, 0, 2, longText,  text_color=color.black, bgcolor=longColor,  text_size=size.small, text_halign=text.align_center)
    table.cell(screenerTable, 1, 2, shortText, text_color=color.black, bgcolor=shortColor, text_size=size.small, text_halign=text.align_center)

// === TREND ANALYSIS DASHBOARD ===
trendStateText(int code) =>
    switch code
        3  => "Strong Bullish"
        2  => "Bullish"
        1  => "Bullish Sideways"
        -1 => "Bearish Sideways"
        -2 => "Bearish"
        -3 => "Strong Bearish"
        => "Sideways"

trendStateColor(int code) =>
    switch code
        3  => color.new(#00e676, 0)
        2  => color.new(#81c784, 0)
        1  => color.new(#c5e1a5, 0)
        -1 => color.new(#ffcc80, 0)
        -2 => color.new(#e57373, 0)
        -3 => color.new(#ff1744, 0)
        => color.new(#ffd600, 0)

trendTfRow(table t, int row, string tf, int code, float adxV, float adxPrev) =>
    table.cell(t, 0, row, getTFLabel(tf), text_color=color.black, bgcolor=color.new(#03f7ff,0), text_size=size.small)
    table.cell(t, 1, row, na(adxV) ? "-" : trendStateText(code), text_color=color.black, bgcolor=trendStateColor(code), text_size=size.small)
    string adxText = na(adxV) ? "-" : str.tostring(adxV, "#") + (adxV > nz(adxPrev) ? " ▲" : " ▼")
    table.cell(t, 2, row, adxText, text_color=color.white, bgcolor=color.new(#212121,0), text_size=size.small)

if showDashboard and barstate.islast
    var table dashboardTable = table.new(getTablePosition(dashboardPosition), 3, 6,
         bgcolor = color.new(color.rgb(33, 33, 33), 80),
         border_width = 2, border_color = color.new(widgetBorderColor, 0),
         frame_width = 3, frame_color = color.new(widgetBorderColor, 0))

    // Header
    table.cell(dashboardTable, 0, 0, "𝗧𝗥𝗘𝗡𝗗 𝗔𝗡𝗔𝗟𝗬𝗦𝗜𝗦", text_color=color.black, bgcolor=color.new(#03f7ff,0), text_size=size.normal, text_halign=text.align_center)
    table.merge_cells(dashboardTable, 0, 0, 2, 0)

    // Combined verdict from the three timeframes
    string verdictIcon = trendVerdictCode > 0 ? " 🐂" : trendVerdictCode < 0 ? " 🐻" : ""
    table.cell(dashboardTable, 0, 1, "𝗦𝗧𝗔𝗧𝗨𝗦", text_color=color.black, bgcolor=color.new(#03f7ff,0), text_size=size.small)
    table.cell(dashboardTable, 1, 1, trendVerdictText + verdictIcon, text_color=color.black, bgcolor=trendStateColor(trendVerdictCode), text_size=size.small)
    table.merge_cells(dashboardTable, 1, 1, 2, 1)

    // Individual timeframes: trend state and ADX (▲ getting stronger, ▼ getting weaker)
    trendTfRow(dashboardTable, 2, combinedTrendTF1, tf1Code, tf1Adx, tf1AdxPrev)
    trendTfRow(dashboardTable, 3, combinedTrendTF2, tf2Code, tf2Adx, tf2AdxPrev)
    trendTfRow(dashboardTable, 4, combinedTrendTF3, tf3Code, tf3Adx, tf3AdxPrev)

    table.cell(dashboardTable, 0, 5, "ADX ▲ = trend strengthening, ▼ = weakening", text_color=color.white, bgcolor=color.new(#212121,0), text_size=size.tiny)
    table.merge_cells(dashboardTable, 0, 5, 2, 5)

// === MARKET ANALYSIS DASHBOARD ===
if showMarket and barstate.islast
    var table marketTable = table.new(getTablePosition(marketPosition), 2, showVolumeRow ? 12 : 11,
         bgcolor = color.new(color.rgb(33, 33, 33), 80),
         border_width = 2, border_color = color.new(widgetBorderColor, 0),
         frame_width = 3, frame_color = color.new(widgetBorderColor, 0))
    color headBg = color.new(#03f7ff, 0)
    color upBg   = color.new(#00c853, 0)
    color downBg = color.new(#d50000, 0)
    color waitBg = color.new(#ffd600, 0)
    color darkBg = color.new(#212121, 0)

    table.cell(marketTable, 0, 0, "𝗠𝗔𝗥𝗞𝗘𝗧 𝗔𝗡𝗔𝗟𝗬𝗦𝗜𝗦", text_color=color.black, bgcolor=headBg, text_size=size.normal, text_halign=text.align_center)
    table.merge_cells(marketTable, 0, 0, 1, 0)

    // Momentum: direction of the EMA ribbon on this timeframe
    table.cell(marketTable, 0, 1, "Momentum", text_color=color.black, bgcolor=headBg, text_size=size.small)
    table.cell(marketTable, 1, 1, ribbonDir ? "UPTREND" : "DOWNTREND", text_color=color.black, bgcolor=ribbonDir ? upBg : downBg, text_size=size.small)

    // Strength: how strongly the market is moving (not which way), with its direction of change
    bool trending = adx >= adxThreshold
    string adxState = adx >= 40 ? " Very Strong" : adx >= trendStrongAdx ? " Strong" : trending ? " Trending" : " Sideways"
    string adxArrow = adx > adx[1] ? " ▲" : " ▼"
    table.cell(marketTable, 0, 2, "Strength (ADX)", text_color=color.black, bgcolor=headBg, text_size=size.small)
    table.cell(marketTable, 1, 2, str.tostring(adx, "#.0") + adxState + adxArrow, text_color=color.black, bgcolor=trending ? upBg : waitBg, text_size=size.small)

    // Structure: direction of the most recent break of structure, and how long ago it happened
    string structText = structDir > 0 ? "BULLISH BOS" : structDir < 0 ? "BEARISH BOS" : "No BOS yet"
    if not na(structBar)
        structText += " (" + str.tostring(bar_index - structBar) + " bars ago)"
    color structColor = structDir > 0 ? upBg : structDir < 0 ? downBg : waitBg
    table.cell(marketTable, 0, 3, "Structure", text_color=color.black, bgcolor=headBg, text_size=size.small)
    table.cell(marketTable, 1, 3, structText, text_color=color.black, bgcolor=structColor, text_size=size.small)

    // Alignment: momentum, structure and the Trend Analysis verdict read together
    int momDir = ribbonDir ? 1 : -1
    int bigDir = trendVerdictCode > 0 ? 1 : trendVerdictCode < 0 ? -1 : 0
    string alignText = "CONFLICT - wait"
    color alignBg = waitBg
    if bigDir == 0
        alignText := "SIDEWAYS / MIXED - wait"
    else if momDir == bigDir and structDir == bigDir
        alignText := bigDir > 0 ? "ALIGNED BULLISH" : "ALIGNED BEARISH"
        alignBg := bigDir > 0 ? upBg : downBg
    else if structDir == bigDir
        alignText := bigDir > 0 ? "PULLBACK in uptrend" : "PULLBACK in downtrend"
    else if momDir == bigDir
        alignText := bigDir > 0 ? "WAIT bullish BOS" : "WAIT bearish BOS"
    table.cell(marketTable, 0, 4, "Alignment", text_color=color.black, bgcolor=headBg, text_size=size.small)
    table.cell(marketTable, 1, 4, alignText, text_color=color.black, bgcolor=alignBg, text_size=size.small)

    // Entry Bias: an opinion from trend, strength and zones. Information only, the entry signals ignore it.
    bool biasTrendOK = ribbonDir ? close > maEmaTrend : close < maEmaTrend
    bool biasZoneOK  = ribbonDir ? not inSupply : not inDemand
    bool biasOK = biasTrendOK and trending and biasZoneOK
    string blockedBy = ""
    if not biasTrendOK
        blockedBy += " Trend"
    if not trending
        blockedBy += " ADX"
    if not biasZoneOK
        blockedBy += " Zone"
    string biasText = biasOK ? (ribbonDir ? "BUY only" : "SELL only") : "WAIT:" + blockedBy
    color biasBg = biasOK ? (ribbonDir ? upBg : downBg) : waitBg
    table.cell(marketTable, 0, 5, "Entry Bias", text_color=color.black, bgcolor=headBg, text_size=size.small)
    table.cell(marketTable, 1, 5, biasText, text_color=color.black, bgcolor=biasBg, text_size=size.small)

    // Where price is relative to the zones
    table.cell(marketTable, 0, 6, "Price Position", text_color=color.black, bgcolor=headBg, text_size=size.small)
    table.cell(marketTable, 1, 6, inSupply ? "Inside SUPPLY" : inDemand ? "Inside DEMAND" : "Between zones", text_color=color.white, bgcolor=inSupply ? color.new(supplyColor, 0) : inDemand ? color.new(demandColor, 0) : darkBg, text_size=size.small)

    MaZone nearS = nearestZone(maSupplyZones, true)
    MaZone nearD = nearestZone(maDemandZones, false)
    string supplyText = "No zone above"
    string demandText = "No zone below"
    if not na(nearS)
        supplyText := str.tostring(nearS.bottom, format.mintick) + " - " + str.tostring(nearS.top, format.mintick) + (nearS.tests > 0 ? " (test " + str.tostring(nearS.tests) + ")" : " (fresh)")
    if not na(nearD)
        demandText := str.tostring(nearD.bottom, format.mintick) + " - " + str.tostring(nearD.top, format.mintick) + (nearD.tests > 0 ? " (test " + str.tostring(nearD.tests) + ")" : " (fresh)")
    table.cell(marketTable, 0, 7, "Nearest Supply", text_color=color.black, bgcolor=headBg, text_size=size.small)
    table.cell(marketTable, 1, 7, supplyText, text_color=color.white, bgcolor=color.new(supplyColor, 0), text_size=size.small)
    table.cell(marketTable, 0, 8, "Nearest Demand", text_color=color.black, bgcolor=headBg, text_size=size.small)
    table.cell(marketTable, 1, 8, demandText, text_color=color.white, bgcolor=color.new(demandColor, 0), text_size=size.small)

    // Scorecard over the loaded history: did TP1 come before SL?
    int closedTrades = tp1Wins + slLosses
    string rateText = closedTrades > 0 ? str.tostring(100.0 * tp1Wins / closedTrades, "#.0") + "% (" + str.tostring(tp1Wins) + "/" + str.tostring(closedTrades) + ")" : "-"
    table.cell(marketTable, 0, 9, "TP1 before SL", text_color=color.black, bgcolor=headBg, text_size=size.small)
    table.cell(marketTable, 1, 9, rateText, text_color=color.white, bgcolor=darkBg, text_size=size.small)

    // The signal that is currently running, and how many targets it has reached
    int tpsReached = 0
    for hit in tpHitStatus
        if hit
            tpsReached += 1
    string tradeText = "No running signal"
    color tradeBg = darkBg
    color tradeTextColor = color.white
    if tradeActive
        tradeText := (tradeDirection > 0 ? "BUY running" : "SELL running") + " (TP " + str.tostring(tpsReached) + "/" + str.tostring(array.size(tpHitStatus)) + ")"
        tradeBg := tradeDirection > 0 ? upBg : downBg
        tradeTextColor := color.black
    table.cell(marketTable, 0, 10, "Signal Status", text_color=color.black, bgcolor=headBg, text_size=size.small)
    table.cell(marketTable, 1, 10, tradeText, text_color=tradeTextColor, bgcolor=tradeBg, text_size=size.small)

    if showVolumeRow
        volText = na(volume) ? "N/A" : str.tostring(math.round(volume))
        table.cell(marketTable, 0, 11, "Volume", text_color=color.black, bgcolor=headBg, text_size=size.small)
        table.cell(marketTable, 1, 11, volText, text_color=color.white, bgcolor=darkBg, text_size=size.small)
